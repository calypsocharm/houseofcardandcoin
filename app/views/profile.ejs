<%- include('_top',{title:who.name,active:'guild',desc:who.name+' of the House of Card and Coin — rank, faires camped, hand and doings before the Age of Chivalry Renaissance Festival.',image:'/assets/img/og/index.jpg',url:'https://houseofcardandcoin.com/guild/'+slug}) %>
<link rel="stylesheet" href="/assets/css/profile.css?v=<%= typeof assetv!=='undefined'?assetv:'1' %>">

<%
  /* Their three colours ride in as custom properties. Each has already been
     matched against a six-digit hex on the way into the record, and the
     backdrop and arrangement against fixed lists, so nothing here can become a
     style rule of somebody's own devising. */
%>
<%
  /* The banner rides in as a custom property beside the colours rather than as
     a style attribute built in the template. Building the attribute itself out
     of a tag meant the whole thing came back escaped — style=&#34;…&#34; — and
     the browser saw text where a style should have been. Only values go through
     a tag here; the quoting around them is the template's own. */
%>
<div class="pro" data-backdrop="<%= page.backdrop %>" data-layout="<%= page.layout %>"
     style="--u-accent:<%= page.accent %>;--u-seal:<%= page.seal %>;--u-tint:<%= page.tint %>;--u-ink:<%= page.ink %>;--u-font:<%= page.fontStack %>;--u-scale:<%= page.sizeScale %><% if(page.banner){ %>;--u-banner:url('<%= page.banner %>')<% } %>">
  <div class="pro-banner<%= page.banner?' pro-banner--own':'' %>" aria-hidden="true">
    <% if(!page.banner){ %><span class="pro-banner__art"></span><% } %>
    <span class="pro-banner__fade"></span>
    <%
      /* Charms hang on the banner, where they cannot land on top of anything
         anyone needs to read. Position is a percentage of the banner, so they
         sit in the same place on a phone as on a laptop. The artwork is ours,
         looked up by a key that has already been checked against the list. */
    %>
    <% if(page.charms.length){ %>
      <span class="pro-charms">
        <% page.charms.forEach(function(c){ %>
          <span class="pro-charm is-<%= c.c %>" style="left:<%= c.x %>%;top:<%= c.y %>%;--c-size:<%= c.s %>"><%- charmSvg(c.k,c.c) %></span>
        <% }) %>
      </span>
    <% } %>
  </div>

  <div class="container">
    <div class="pro-ident">
      <div class="pro-ident__row">
        <% if(who.avatar){ %>
          <img class="pro-face" src="<%= who.avatar %>" alt="<%= who.name %>">
        <% } else { %>
          <span class="pro-face pro-face--init"><%= who.name.slice(0,2).toUpperCase() %></span>
        <% } %>
        <div class="pro-ident__words">
          <h1><%= who.name %></h1>
          <div class="pro-pills">
            <span class="pro-pill"><%= who.rank %></span>
            <% if(who.title && who.title!==who.rank){ %><span class="pro-pill pro-pill--seal"><%= who.title %></span><% } %>
            <% if(who.cls){ %><span class="pro-pill pro-pill--quiet"><%= who.cls %></span><% } %>
            <% if(who.rsvp){ %><span class="pro-pill pro-pill--quiet">✓ Coming in 2026</span><% } %>
          </div>
          <% if(page.motto){ %><p class="pro-motto">“<%= page.motto %>”</p><% } %>
          <% if(who.pledge){ %>
            <p class="pro-note">A pledge of the House — awaiting the Guild Leader’s word.</p>
          <% } %>
        </div>
      </div>
      <% if(canWhisper){ %>
        <p class="pro-acts"><a class="btn btn--wine" href="<%= whisperTo %>">Whisper to <%= who.name %></a></p>
      <% } %>
      <p class="pro-back"><a href="/guild.html">← Back to the roster</a><% if(isMe){ %> · <a href="/members#page">Change how this page looks</a> · <a href="/members#profile">Your details</a><% } %></p>
    </div>

    <div class="pro-cols">
      <div class="pro-rail">
        <div class="pro-card">
          <h2>The Sheet</h2>
          <ul class="pro-sheet">
            <li><span class="k">Rank</span><span class="v"><%= who.rank %></span></li>
            <li><span class="k">Faires camped</span><span class="v"><%= who.faires %></span></li>
            <li><span class="k">Coming in 2026</span><span class="v"><%= who.rsvp?'Yes':'Not said yet' %></span></li>
            <li><span class="k">Bunk</span><span class="v"><%= bunks.length?bunks.join('; '):'None held' %></span></li>
            <li><span class="k">Coins</span><span class="v"><%= who.coins %></span></li>
            <% if(who.streak){ %><li><span class="k">Nights in a row</span><span class="v"><%= who.streak %></span></li><% } %>
          </ul>
        </div>

        <div class="pro-card">
          <h2>Bringing to Camp</h2>
          <% if(bringing.length){ %>
            <ul class="pro-sheet">
              <% bringing.forEach(function(b){ %>
                <li><span class="k"><%= b.name %></span><span class="v"><%= b.qty %></span></li>
              <% }) %>
            </ul>
          <% } else { %>
            <p class="pro-empty">Nothing claimed off the bring-list yet.<% if(isMe){ %> <a href="/members#bring">Claim something</a>.<% } %></p>
          <% } %>
        </div>
      </div>

      <div class="pro-main">
        <% if(page.about){ %>
          <div class="pro-card">
            <h2>Of <%= isMe?'Yourself':'Them' %></h2>
            <p class="pro-about"><%= page.about %></p>
          </div>
        <% } else if(isMe){ %>
          <div class="pro-card">
            <h2>Of Yourself</h2>
            <p class="pro-empty">Nothing written yet. <a href="/members#page">Say a few words</a> and they sit here.</p>
          </div>
        <% } %>

        <div class="pro-card">
          <h2>The Hand<% if(handRank){ %> — <b class="pro-rank"><%= handRank.name %></b><% } %></h2>
          <% if(hand.length){ %>
            <div class="pro-hand">
              <% hand.forEach(function(c){ %>
                <span class="pro-card-face <%= c.red?'is-red':'is-blk' %>">
                  <b><%= c.r %><%= c.glyph %></b><b><%= c.r %><%= c.glyph %></b>
                </span>
              <% }) %>
            </div>
            <p class="pro-empty" style="margin-top:12px">Five nights, five cards. Shown at the faire for the finest hand of the weekend.</p>
          <% } else { %>
            <p class="pro-empty">No cards drawn yet.<% if(isMe){ %> <a href="/board#hand">Take tonight’s card</a>.<% } else { %> The House deals one a night to anyone who comes by the Tavern.<% } %></p>
          <% } %>
        </div>

        <div class="pro-card">
          <h2>Lately in the Tavern</h2>
          <% if(talk.length){ %>
            <% talk.forEach(function(s){ %>
              <a class="pro-said" href="/board/thread/<%= s.tid %>">
                <span class="pro-said__w"><%= new Date(s.ts).toLocaleDateString(undefined,{month:'short',day:'numeric'}) %></span>
                <span class="pro-said__b"><%= s.body.length>190?s.body.slice(0,190)+'…':s.body %></span>
              </a>
            <% }) %>
          <% } else { %>
            <p class="pro-empty"><%= who.name %> has not spoken by the fire yet.<% if(isMe){ %> <a href="/board">Say something</a>.<% } %></p>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<% if(page.sparkle){ %>
<script>
/* Their sparkles, on their page only. Ours to draw, theirs to switch on —
   which is the whole trick: all the fun of a decorated page, none of it
   running anybody else's code. */
(function(){
  if(window.matchMedia('(prefers-reduced-motion:reduce)').matches)return;
  var last=0;
  addEventListener('pointermove',function(e){
    var now=Date.now(); if(now-last<45)return; last=now;
    var s=document.createElement('div');
    s.className='pro-sparkle';
    s.style.left=(e.clientX-4)+'px'; s.style.top=(e.clientY-4)+'px';
    document.body.appendChild(s);
    setTimeout(function(){ s.remove(); },900);
  },{passive:true});
})();
</script>
<% } %>
<%- include('_bot') %>

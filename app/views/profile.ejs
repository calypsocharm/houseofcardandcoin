<%- include('_top',{title:who.name,active:'guild',desc:who.name+' of the House of Card and Coin — rank, faires camped, hand and doings before the Age of Chivalry Renaissance Festival.',image:'/assets/img/og/index.jpg',url:'https://houseofcardandcoin.com/guild/'+slug}) %>
<link rel="stylesheet" href="/assets/css/profile.css?v=<%= typeof assetv!=='undefined'?assetv:'1' %>">

<%
  /* Their three colours ride in as custom properties. Each has already been
     matched against a six-digit hex on the way into the record, and the
     backdrop and arrangement against fixed lists, so nothing here can become a
     style rule of somebody's own devising. */
%>
<%
  /* The banner rides in as a custom property beside the colours rather than as
     a style attribute built in the template. Building the attribute itself out
     of a tag meant the whole thing came back escaped — style=&#34;…&#34; — and
     the browser saw text where a style should have been. Only values go through
     a tag here; the quoting around them is the template's own. */
%>
<div class="pro" data-backdrop="<%= page.backdrop %>" data-layout="<%= page.layout %>"
     style="--u-accent:<%= page.accent %>;--u-seal:<%= page.seal %>;--u-tint:<%= page.tint %>;--u-ink:<%= page.ink %>;--u-font:<%= page.fontStack %>;--u-scale:<%= page.sizeScale %><% if(page.banner){ %>;--u-banner:url('<%= page.banner %>')<% } %>">
  <div class="pro-banner<%= page.banner?' pro-banner--own':'' %>" aria-hidden="true">
    <% if(!page.banner){ %><span class="pro-banner__art"></span><% } %>
    <span class="pro-banner__fade"></span>
    <%
      /* Charms hang on the banner, where they cannot land on top of anything
         anyone needs to read. Position is a percentage of the banner, so they
         sit in the same place on a phone as on a laptop. The artwork is ours,
         looked up by a key that has already been checked against the list. */
    %>
    <% if(page.charms.length){ %>
      <span class="pro-charms">
        <% page.charms.forEach(function(c){ %>
          <span class="pro-charm is-<%= c.c %>" style="left:<%= c.x %>%;top:<%= c.y %>%;--c-size:<%= c.s %>"><%- charmSvg(c.k) %></span>
        <% }) %>
      </span>
    <% } %>
  </div>
  <%
    /* The wax seal, pressed into the corner of the banner with your initials.
       The colour picker was called "wax seal" before there was one, which meant
       it only tinted a title badge that most people never see — so on most pages
       it appeared to do nothing at all. Now it has something to colour. */
    var initials = String(who.name||'?').trim().split(/\s+/).map(function(w){return w.charAt(0);}).join('').slice(0,2).toUpperCase();
  %>
  <span class="pro-seal" aria-hidden="true"><span class="pro-seal__mark"><%= initials %></span></span>

  <div class="container">
    <div class="pro-ident">
      <div class="pro-ident__row">
        <% if(who.avatar){ %>
          <img class="pro-face" src="<%= who.avatar %>" alt="<%= who.name %>">
        <% } else { %>
          <span class="pro-face pro-face--init"><%= who.name.slice(0,2).toUpperCase() %></span>
        <% } %>
        <div class="pro-ident__words">
          <h1><%= who.name %></h1>
          <div class="pro-pills">
            <span class="pro-pill"><%= who.rank %></span>
            <% if(who.title && who.title!==who.rank){ %><span class="pro-pill pro-pill--seal"><%= who.title %></span><% } %>
            <% if(who.cls){ %><span class="pro-pill pro-pill--quiet"><%= who.cls %></span><% } %>
            <% if(who.rsvp){ %><span class="pro-pill pro-pill--quiet">✓ Coming in 2026</span><% } %>
          </div>
          <% if(page.motto){ %><p class="pro-motto">“<%= page.motto %>”</p><% } %>
          <% if(who.pledge){ %>
            <p class="pro-note">A pledge of the House — awaiting the Guild Leader’s word.</p>
          <% } %>
        </div>
      </div>
      <% if(canWhisper){ %>
        <p class="pro-acts"><a class="btn btn--wine" href="<%= whisperTo %>">Whisper to <%= who.name %></a></p>
      <% } %>
      <p class="pro-back"><a href="/guild.html">← Back to the roster</a><% if(isMe){ %> · <a href="/members#profile">Your name, face and rank</a><% } %></p>
    </div>

    <div class="pro-cols">
      <div class="pro-rail">
        <div class="pro-card">
          <h2>The Sheet</h2>
          <ul class="pro-sheet">
            <li><span class="k">Rank</span><span class="v"><%= who.rank %></span></li>
            <li><span class="k">Faires camped</span><span class="v"><%= who.faires %></span></li>
            <li><span class="k">Coming in 2026</span><span class="v"><%= who.rsvp?'Yes':'Not said yet' %></span></li>
            <li><span class="k">Bunk</span><span class="v"><%= bunks.length?bunks.join('; '):'None held' %></span></li>
            <li><span class="k">Coins</span><span class="v"><%= who.coins %></span></li>
            <% if(who.streak){ %><li><span class="k">Nights in a row</span><span class="v"><%= who.streak %></span></li><% } %>
          </ul>
        </div>

        <div class="pro-card">
          <h2>Bringing to Camp</h2>
          <% if(bringing.length){ %>
            <ul class="pro-sheet">
              <% bringing.forEach(function(b){ %>
                <li><span class="k"><%= b.name %></span><span class="v"><%= b.qty %></span></li>
              <% }) %>
            </ul>
          <% } else { %>
            <p class="pro-empty">Nothing claimed off the bring-list yet.<% if(isMe){ %> <a href="/members#bring">Claim something</a>.<% } %></p>
          <% } %>
        </div>
      </div>

      <div class="pro-main">
        <% if(page.about){ %>
          <div class="pro-card">
            <h2>Of <%= isMe?'Yourself':'Them' %></h2>
            <p class="pro-about"><%= page.about %></p>
          </div>
        <% } else if(isMe){ %>
          <div class="pro-card">
            <h2>Of Yourself</h2>
            <p class="pro-empty">Nothing written yet. Press <b>Dress this page</b> and say a few words — they sit here.</p>
          </div>
        <% } %>

        <div class="pro-card">
          <h2>The Hand<% if(handRank){ %> — <b class="pro-rank"><%= handRank.name %></b><% } %></h2>
          <% if(hand.length){ %>
            <div class="pro-hand">
              <% hand.forEach(function(c){ %>
                <span class="pro-card-face <%= c.red?'is-red':'is-blk' %>">
                  <b><%= c.r %><%= c.glyph %></b><b><%= c.r %><%= c.glyph %></b>
                </span>
              <% }) %>
            </div>
            <p class="pro-empty" style="margin-top:12px">Five nights, five cards. Shown at the faire for the finest hand of the weekend.</p>
          <% } else { %>
            <p class="pro-empty">No cards drawn yet.<% if(isMe){ %> <a href="/board#hand">Take tonight’s card</a>.<% } else { %> The House deals one a night to anyone who comes by the Tavern.<% } %></p>
          <% } %>
        </div>

        <div class="pro-card" id="wall">
          <h2>Sign <%= isMe?'Your':'Their' %> Scroll</h2>
          <% if(q && q.e){ %><p class="pro-warn"><%= q.e %></p><% } %>

          <% if(canSign){ %>
            <form class="pro-sign" method="post" action="/guild/<%= slug %>/sign">
              <input name="body" maxlength="400" required
                     placeholder="<%= isMe?'Leave a line on your own scroll…':'Leave a line for '+who.name+'…' %>"
                     aria-label="Leave a line on this scroll">
              <button class="btn btn--wine" type="submit">Sign</button>
            </form>
          <% } else { %>
            <p class="pro-empty"><a href="/members/login">Sign in</a> or
              <a href="/tavern">claim a seat in the Tavern</a> to leave a line. Anyone may read it.</p>
          <% } %>

          <% if(wall.length){ %>
            <% wall.forEach(function(w){ %>
              <div class="pro-scrap">
                <p class="pro-scrap__w">
                  <% if(w.slug){ %><a href="/guild/<%= w.slug %>"><%= w.who %></a><% } else { %><%= w.who %><% } %>
                  <span class="pro-scrap__when"><%= new Date(w.ts).toLocaleDateString(undefined,{month:'short',day:'numeric'}) %></span>
                </p>
                <p class="pro-scrap__b"><%= w.body %></p>
                <% if(canSign && (isMe || (i && i.t===w.fromT && i.id===w.fromId) || leader)){ %>
                  <form method="post" action="/guild/wall/<%= w.id %>/remove" class="pro-scrap__x"
                        onsubmit="return confirm('Take this line off the scroll?')">
                    <button type="submit">Strike</button>
                  </form>
                <% } %>
              </div>
            <% }) %>
          <% } else { %>
            <p class="pro-empty" style="margin-top:12px">
              <%= isMe?'Nobody has signed your scroll yet.':'No one has signed this scroll yet — be the first.' %>
            </p>
          <% } %>
        </div>

        <div class="pro-card">
          <h2>Lately in the Tavern</h2>
          <% if(talk.length){ %>
            <% talk.forEach(function(s){ %>
              <a class="pro-said" href="/board/thread/<%= s.tid %>">
                <span class="pro-said__w"><%= new Date(s.ts).toLocaleDateString(undefined,{month:'short',day:'numeric'}) %></span>
                <span class="pro-said__b"><%= s.body.length>190?s.body.slice(0,190)+'…':s.body %></span>
              </a>
            <% }) %>
          <% } else { %>
            <p class="pro-empty"><%= who.name %> has not spoken by the fire yet.<% if(isMe){ %> <a href="/board">Say something</a>.<% } %></p>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<% if(isMe){ %>
<!-- ── Dressing the page, on the page ───────────────────────────────────────
     This used to be a form in the Guild Hall with a shrunken copy of the page
     beside it. A copy can disagree with the original, and did: wax charms
     previewed in a colour nobody had chosen. There is nothing to keep in step
     now, because there is only one of it — every control writes straight onto
     the page you are looking at, and charms are dragged on the real banner at
     its real size. Nothing is written down until you press Save. -->
<div class="dress" id="dress" data-open="0" data-max="<%= charmMax %>">
  <button type="button" class="dress__tab" id="dressTab" aria-expanded="false" aria-controls="dressBody">
    <span>Dress this page</span>
  </button>

  <form class="dress__body" id="dressBody" method="post" action="/members/page" enctype="multipart/form-data">

    <div class="dress__grp">
      <label for="pgMotto">Motto</label>
      <input id="pgMotto" name="motto" maxlength="90" value="<%= page.motto %>" placeholder="Every bargain has its price…">
    </div>

    <div class="dress__grp">
      <label for="pgAbout">Of yourself</label>
      <textarea id="pgAbout" name="about" rows="3" maxlength="700" placeholder="Who you are at camp, and where to find you after dark."><%= page.about %></textarea>
    </div>

    <div class="dress__grp">
      <label>Colours</label>
      <div class="dress__swatches">
        <span><input id="pgAccent" type="color" name="accent" value="<%= page.accent %>"><small>Accent</small></span>
        <span><input id="pgSeal" type="color" name="seal" value="<%= page.seal %>"><small>Wax</small></span>
        <span><input id="pgTint" type="color" name="tint" value="<%= page.tint %>"><small>Ground</small></span>
        <span><input id="pgInk" type="color" name="ink" value="<%= page.ink %>"><small>Writing</small></span>
      </div>
    </div>

    <div class="dress__grp dress__two">
      <span>
        <label for="pgFont">Lettering</label>
        <select id="pgFont" name="font">
          <% fontKeys.forEach(function(k){ %><option value="<%= k %>"<%= page.font===k?' selected':'' %>><%= fonts[k].label %></option><% }) %>
        </select>
      </span>
      <span>
        <label for="pgSize">Size</label>
        <select id="pgSize" name="size">
          <% sizeKeys.forEach(function(k){ %><option value="<%= k %>"<%= page.size===k?' selected':'' %>><%= k.charAt(0).toUpperCase()+k.slice(1) %></option><% }) %>
        </select>
      </span>
    </div>

    <div class="dress__grp dress__two">
      <span>
        <label for="pgBack">Backdrop</label>
        <select id="pgBack" name="backdrop">
          <% backdrops.forEach(function(b){ %><option value="<%= b %>"<%= page.backdrop===b?' selected':'' %>><%= b.charAt(0).toUpperCase()+b.slice(1) %></option><% }) %>
        </select>
      </span>
      <span>
        <label for="pgLay">Arrangement</label>
        <select id="pgLay" name="layout">
          <% layouts.forEach(function(l){ %><option value="<%= l %>"<%= page.layout===l?' selected':'' %>><%= l==='sheet'?'Two column':(l==='scroll'?'Scroll':'Poster') %></option><% }) %>
        </select>
      </span>
    </div>

    <div class="dress__grp">
      <label for="pgBanner">Banner</label>
      <input id="pgBanner" type="file" name="banner" accept="image/*">
      <% if(page.banner){ %>
        <label class="dress__check"><input type="checkbox" name="dropBanner" value="1"> Take the banner off</label>
      <% } %>
    </div>

    <div class="dress__grp">
      <label>Charms — click to hang, drag on the banner</label>
      <div class="dress__tray" id="charmTray">
        <% charmKeys.forEach(function(k){ %>
          <button type="button" class="dress__charm" data-charm="<%= k %>" title="Hang a <%= k %>" aria-label="Hang a <%= k %>"><%- charmSvg(k) %></button>
        <% }) %>
      </div>
      <small class="dress__hint">Click a charm on the banner to recolour it, double-click to take it off.
        <b id="charmCount"><%= page.charms.length %></b>/<%= charmMax %></small>
      <input type="hidden" name="charms" id="pgCharms" value="<%= JSON.stringify(page.charms) %>">
    </div>

    <label class="dress__check">
      <input type="checkbox" name="sparkle" value="1"<%= page.sparkle?' checked':'' %>> Sparkles follow the cursor
    </label>

    <div class="dress__foot">
      <button class="btn btn--gold" type="submit">Save my page</button>
      <span class="dress__state" id="dressState">Nothing changed yet</span>
    </div>
  </form>
</div>
<% } %>

<% if(isMe){ %>
<script>window.__CHARM_ART__=<%- JSON.stringify(charmKeys.reduce(function(m,k){m[k]=charmSvg(k);return m;},{})) %>;window.__FONTS__=<%- JSON.stringify(fontKeys.reduce(function(m,k){m[k]=fonts[k].stack;return m;},{})) %>;window.__SIZES__=<%- JSON.stringify(sizes) %>;</script>
<script defer src="/assets/js/dress.js?v=<%= typeof assetv!=='undefined'?assetv:'1' %>"></script>
<% } %>

<% if(page.sparkle){ %>
<script>
/* Their sparkles, on their page only. Ours to draw, theirs to switch on —
   which is the whole trick: all the fun of a decorated page, none of it
   running anybody else's code. */
(function(){
  if(window.matchMedia('(prefers-reduced-motion:reduce)').matches)return;
  var last=0;
  addEventListener('pointermove',function(e){
    var now=Date.now(); if(now-last<45)return; last=now;
    var s=document.createElement('div');
    s.className='pro-sparkle';
    s.style.left=(e.clientX-4)+'px'; s.style.top=(e.clientY-4)+'px';
    document.body.appendChild(s);
    setTimeout(function(){ s.remove(); },900);
  },{passive:true});
})();
</script>
<% } %>
<%- include('_bot') %>

<%- include('_top',{title:'The Tavern',active:'board',desc:'The Tavern of the House of Card and Coin — notices, wagers and talk by the fire before the Age of Chivalry Renaissance Festival.',image:'/assets/img/og/index.jpg',url:'https://houseofcardandcoin.com/board'}) %>
<link rel="stylesheet" href="/assets/css/tavern.css?v=<%= typeof cssv!=='undefined'?cssv:'1' %>">

<!-- ── The way in ────────────────────────────────────────────────────────────
     Barred doors with a peep slot: the House looks you over, decides it knows
     you, and lets you through. Purely decorative — it is hidden unless the
     script in the head has put .tav-enter on <html>, so a browser with
     scripting off, or anyone who asked for less motion, never meets it. -->
<div class="tavdoor" aria-hidden="true">
  <span class="tavdoor__glow"></span>
  <div class="tavdoor__leaf tavdoor__leaf--l"></div>
  <div class="tavdoor__leaf tavdoor__leaf--r"></div>
  <span class="tavdoor__slot"><i class="tavdoor__peek"></i><i class="tavdoor__shutter"></i></span>
  <p class="tavdoor__word">Whispers, wagers, and well-kept secrets</p>
</div>

<div class="tav">

  <!-- ── the stage: the room, pinned while the talk scrolls past ───────── -->
  <div class="tav-stage">
    <div class="tav-room" data-quiet="<%= quietHrs %>" data-near="<%= near %>">
      <div class="tav-wall"></div>
      <div class="tav-beam"></div>
      <span class="tav-lantern tav-lantern--l"></span>
      <span class="tav-lantern tav-lantern--r"></span>
      <div class="tav-hearth"></div>
      <canvas class="tav-fx" id="tavFx"></canvas>
      <div class="tav-floor"></div>

      <div class="tav-table" aria-hidden="true">
        <span class="tav-tankard tav-tankard--a"></span>
        <span class="tav-candle"></span>
        <span class="tav-tankard tav-tankard--b"></span>
      </div>

      <div class="tav-folk">
        <%
          /* A face goes to that person's page now. Whispering has not gone
             away — it moved onto the page, where it is a labelled button
             rather than something you had to guess a small figure would do.
             Tavern seats have no page, so they keep the whisper link. */
        %>
        <% folk.slice(0,5).forEach(function(f,n){ var mine = i && f.t===i.t && f.id===i.id;
             var page = (f.t==='member' && slugs[f.id]) ? '/guild/'+slugs[f.id] : null; %>
          <a class="tav-body<%= mine?' is-me':'' %>" data-depth="<%= (n%2)?'near':'far' %>"
             style="animation-delay:-<%= n*1.3 %>s"
             href="<%= page || ('/board/whisper/'+f.t+'/'+f.id) %>"
             title="<%= page ? f.name+'’s page' : 'Whisper to '+f.name %>">
            <% if(f.avatar){ %>
              <img class="tav-head" src="<%= f.avatar %>" alt="<%= f.name %>">
            <% } else { %>
              <span class="tav-head"><%= f.name.slice(0,2).toUpperCase() %></span>
            <% } %>
            <span class="tav-cloak"></span>
            <span class="tav-plate"><%= f.name %></span>
          </a>
        <% }); %>
        <% if(!folk.length){ %>
          <p class="tav-empty">The fire is banked and the room is quiet.<br>Be the first to speak tonight.</p>
        <% } %>
      </div>
    </div>

    <div class="tav-strip">
      <span class="tav-dot"></span>
      <span class="tav-special">🌙 <%= special %></span>
      <span class="tav-gates">
        <% if(gates.ended){ %>The faire has ended — until next year.
        <% } else if(gates.open){ %><b>The gates are open.</b>
        <% } else { %><b><%= gates.days %></b> days until the gates open<% } %>
      </span>
      <% if(i){ %>
        <a class="tav-purse" href="/board/rogues"><span class="tav-coin">✦</span> <%= i.coins||0 %> coins</a>
      <% } %>
    </div>

    <nav class="tav-doors">
      <a href="/board/rogues">Rogues' Gallery</a>
      <a href="/board/roll">The Roll of Hands</a>
      <% if(i){ %>
        <a href="/board/whispers">Whispers</a>
        <a href="/board/notices">Notices<% if(notices){ %> <b class="tav-pip"><%= notices %></b><% } %></a>
        <form method="post" action="/tavern/logout"><button type="submit">Leave the tavern</button></form>
      <% } else { %>
        <a href="/tavern">Claim a seat</a>
        <a href="/members/login">Guild sign-in</a>
      <% } %>
    </nav>
  </div>

  <% if(q.e){ %><p class="tav-err"><%= q.e %></p><% } %>

  <!-- ── the record: everything said, kept ─────────────────────────────── -->
  <div class="tav-log">

    <!-- polls, in the conversation rather than behind a link -->
    <% polls.forEach(function(p){ %>
      <div class="tav-said">
        <span class="tav-face"><%= (p.authorName||'?').slice(0,2).toUpperCase() %></span>
        <div class="tav-col tav-col--wide">
          <p class="tav-who"><b><%= p.authorName %></b> put a question to the House</p>
          <div class="tav-card">
            <h3>🗳 <%= p.question %></h3>
            <% p.options.forEach(function(o){ var pct = p.total?Math.round(o.votes.length*100/p.total):0; %>
              <% if(i && !p.voted){ %>
                <form method="post" action="/board/poll/<%= p.id %>/vote" class="tav-optform">
                  <input type="hidden" name="option" value="<%= o.id %>">
                  <button class="tav-opt" type="submit"><span class="tav-lbl"><%= o.text %></span></button>
                </form>
              <% } else { %>
                <div class="tav-opt is-result">
                  <span class="tav-fill" style="width:<%= pct %>%"></span>
                  <span class="tav-lbl"><%= o.text %><span class="tav-pct"><%= pct %>%</span></span>
                </div>
              <% } %>
            <% }); %>
            <p class="tav-tally">
              <%= p.total %> vote<%= p.total===1?'':'s' %><% if(!i){ %> · <a href="/tavern">claim a seat to vote</a><% } %>
            </p>
            <% if(leader){ %>
              <form method="post" action="/board/poll/<%= p.id %>/delete"><button class="tav-del" type="submit">Strike this poll</button></form>
            <% } %>
          </div>
        </div>
      </div>
    <% }); %>

    <div class="tav-mark"><span>Talk by the fire</span></div>

    <%
      /* Searching the talk, and a count of what has been said since you were
         last here. Both are plain GET so a search can be shared or bookmarked
         and the back button behaves. */
      var newLines = 0;
      if(seenBefore){
        threads.forEach(function(t){
          if(t.ts>seenBefore && !(i && t.authorType===i.t && t.authorId===i.id)) newLines++;
          (t.replies||[]).forEach(function(r){
            if(r.ts>seenBefore && !(i && r.authorType===i.t && r.authorId===i.id)) newLines++;
          });
        });
      }
    %>
    <div class="tav-find">
      <form method="get" action="/board" role="search">
        <input type="search" name="find" value="<%= find %>" maxlength="60"
               placeholder="Search the talk…" aria-label="Search the talk">
        <button type="submit">Look</button>
        <% if(find){ %><a class="tav-find__clear" href="/board">Clear</a><% } %>
      </form>
      <% if(newLines){ %>
        <p class="tav-find__new"><b><%= newLines %></b> new since you were last here</p>
      <% } %>
    </div>

    <% if(find){ %>
      <p class="tav-found">
        <% if(threads.length){ %>
          <%= found %> conversation<%= found===1?'':'s' %> with “<%= find %>” in <%= found===1?'it':'them' %>.
        <% } else { %>
          Nothing said about “<%= find %>” yet. <a href="/board">Back to the talk</a>.
        <% } %>
      </p>
    <% } %>

    <% if(!threads.length && !find){ %>
      <p class="muted tav-bare">No one has spoken yet. Say the first thing.</p>
    <% } %>

    <%
      /* Flatten each thread and its replies into one run of bubbles, the way a
         conversation actually reads. Consecutive lines from the same person drop
         the avatar and the name so it looks like someone still talking. */
      function stamp(ts){ return new Date(ts).toLocaleDateString(undefined,{month:'short',day:'numeric'}); }
    %>
    <% threads.forEach(function(t){ %>
      <%
        /* reacts and tid ride along so a line can carry its own tally and know
           which thread it belongs to — a reply's react route needs both ids. */
      %>
      <% var run=[{who:t.authorName,av:t.authorAvatar,ty:t.authorType,uid:t.authorId,body:t.body,ts:t.ts,edited:t.edited,kind:'thread',rid:t.id,tid:t.id,reacts:t.reacts}]
             .concat((t.replies||[]).map(function(r){return {who:r.authorName,av:r.authorAvatar,ty:r.authorType,uid:r.authorId,body:r.body,ts:r.ts,edited:r.edited,kind:'reply',rid:r.id,tid:t.id,reacts:r.reacts};})); %>
      <div class="tav-run<%= t.pinned ? ' is-pinned' : '' %>">
        <% if(t.pinned){ %>
          <p class="tav-pinned"><span aria-hidden="true">📌</span> Pinned by
            <b><%= t.pinnedBy || 'the House' %></b></p>
        <% } %>
        <% run.forEach(function(m,n){
             var mine = i && m.ty===i.t && m.uid===i.id;
             var prev = n>0 ? run[n-1] : null;
             var same = prev && prev.ty===m.ty && prev.uid===m.uid;
             var fresh = seenBefore && m.ts > seenBefore && !mine; %>
          <div class="tav-said<%= mine?' is-me':'' %><%= same?' is-cont':'' %><%= fresh?' is-new':'' %>" id="m<%= m.rid %>">
            <% if(canPin && m.kind==='thread'){ %>
              <form class="tav-pin" method="post" action="/board/thread/<%= t.id %>/pin">
                <button type="submit" title="<%= t.pinned ? 'Take this down from the top' : 'Nail this to the top of the board' %>"><%= t.pinned ? 'Unpin' : 'Pin to top' %></button>
              </form>
            <% } %>
            <% var page = (m.ty==='member' && slugs[m.uid]) ? '/guild/'+slugs[m.uid] : null; %>
            <% if(same){ %>
              <span class="tav-face tav-face--ghost" aria-hidden="true"></span>
            <% } else if(page){ %>
              <a href="<%= page %>" title="<%= m.who %>’s page" class="tav-facelink">
                <% if(m.av){ %><img class="tav-face" src="<%= m.av %>" alt="<%= m.who %>">
                <% } else { %><span class="tav-face"><%= (m.who||'?').slice(0,2).toUpperCase() %></span><% } %>
              </a>
            <% } else if(m.av){ %>
              <img class="tav-face" src="<%= m.av %>" alt="<%= m.who %>">
            <% } else { %>
              <span class="tav-face"><%= (m.who||'?').slice(0,2).toUpperCase() %></span>
            <% } %>
            <div class="tav-col">
              <% if(!same){ %>
                <p class="tav-who"><b><%= mine?'You':m.who %></b><span class="tav-when"><%= stamp(m.ts) %></span></p>
              <% } %>
              <div class="tav-scrap"><p><%= m.body %></p><% if(m.edited){ %><span class="tav-edited">edited</span><% } %></div>

              <%
                /* Raising a cup to a line. All of this worked on the server
                   already — toggling, the tally, even telling the author — and
                   had simply never been given a button. Signed out you see the
                   tally of what has been raised, and nothing to press. */
                var act = m.kind==='thread'
                  ? '/board/thread/'+m.rid+'/react'
                  : '/board/thread/'+m.tid+'/reply/'+m.rid+'/react';
                var any = reacts.some(function(e){ return m.reacts && m.reacts[e] && m.reacts[e].length; });
              %>
              <% if(i || any){ %>
                <div class="tav-reacts">
                  <% reacts.forEach(function(e){
                       var who = (m.reacts && m.reacts[e]) || [];
                       var got = i && who.some(function(v){ return v.t===i.t && v.id===i.id; });
                       if(!i && !who.length) return; %>
                    <% if(i){ %>
                      <form method="post" action="<%= act %>" class="tav-reactform">
                        <input type="hidden" name="emoji" value="<%= e %>">
                        <button type="submit" class="tav-react<%= got?' is-mine':'' %>"
                                title="<%= got?'Take it back':'Raise a '+e %>">
                          <span aria-hidden="true"><%= e %></span><% if(who.length){ %><b><%= who.length %></b><% } %>
                        </button>
                      </form>
                    <% } else { %>
                      <span class="tav-react is-read"><span aria-hidden="true"><%= e %></span><b><%= who.length %></b></span>
                    <% } %>
                  <% }) %>
                </div>
              <% } %>
              <% if(mine){ %>
                <%
                  /* A week to put your own words right — replies included, which
                     could never be edited at all before. After that the line is
                     part of the record and the controls give way to a quiet note
                     saying so, rather than buttons that would only be refused. */
                  var base = m.kind==='thread' ? '/board/thread/' : '/board/reply/';
                  var open = (Date.now() - m.ts) < editMs;
                %>
                <div class="tav-own">
                  <% if(open){ %>
                    <details class="tav-editbox"><summary>Edit</summary>
                      <form method="post" action="<%= base %><%= m.rid %>/edit">
                        <input name="body" value="<%= m.body %>" aria-label="Edit your message" required>
                        <button type="submit">Save</button>
                      </form>
                    </details>
                    <% if(m.kind==='thread'){ %>
                      <form method="post" action="/board/thread/<%= m.rid %>/mine/delete" onsubmit="return confirm('Remove this and its replies?')"><button class="tav-mine-del" type="submit">Remove</button></form>
                    <% } else { %>
                      <form method="post" action="/board/reply/<%= m.rid %>/mine/delete" onsubmit="return confirm('Remove your reply?')"><button class="tav-mine-del" type="submit">Remove</button></form>
                    <% } %>
                  <% } else { %>
                    <span class="tav-kept" title="Words older than <%= editDays %> days stand as they were said">Kept as said</span>
                  <% } %>
                </div>
              <% } %>
            </div>
          </div>
        <% }); %>

        <div class="tav-acts">
          <% if(i){ %>
            <form class="tav-replyform" method="post" action="/board/thread/<%= t.id %>/reply">
              <input name="body" placeholder="Answer…" aria-label="Answer this" required>
              <button type="submit">Answer</button>
            </form>
          <% } else { %>
            <a class="tav-cta" href="/tavern">Claim a seat to answer</a>
          <% } %>
          <% if(leader){ %>
            <form method="post" action="/board/thread/<%= t.id %>/delete"><button class="tav-del" type="submit">Strike</button></form>
          <% } %>
        </div>
      </div>
    <% }); %>

    <!-- every hand on the table, best first -->
    <% if(tableHands.length){ %>
      <div class="tav-mark"><span>♠ What everyone's holding</span></div>
      <div class="tav-showdown">
        <div class="tav-showgrid">
        <% tableHands.forEach(function(h){ %>
          <div class="tav-showtile<%= (i && h.name===i.name)?' is-mine':'' %>">
            <% var hpage = (h.kind==='member' && slugs[h.id]) ? '/guild/'+slugs[h.id] : null; %>
            <div class="tav-showhead">
              <% if(hpage){ %><a href="<%= hpage %>" class="tav-facelink" title="<%= h.name %>’s page"><% } %>
              <% if(h.avatar){ %><img class="tav-face tav-face--sm" src="<%= h.avatar %>" alt="<%= h.name %>">
              <% } else { %><span class="tav-face tav-face--sm"><%= h.name.slice(0,2).toUpperCase() %></span><% } %>
              <% if(hpage){ %></a><% } %>
              <span class="tav-showname"><% if(hpage){ %><a href="<%= hpage %>" class="tav-namelink"><%= h.name %></a><% } else { %><%= h.name %><% } %></span>
            </div>
            <span class="tav-showcards">
              <% h.cards.forEach(function(c){ %>
                <span class="pcard pcard--tiny<%= c.red?' is-red':'' %>">
                  <b class="pcard__r"><%= c.r==='T'?'10':c.r %></b><span class="pcard__s"><%= c.glyph %></span>
                </span>
              <% }); %>
              <% for(var k=h.cards.length;k<5;k++){ %><span class="pcard pcard--tiny is-empty"></span><% } %>
            </span>
            <span class="tav-showrank"><%= h.rank ? h.rank.name : '—' %></span>
          </div>
        <% }); %>
        </div>
        <p class="tav-showfoot">A card a night for turning up, dealt blind from your own deck. No trading, no takebacks — bring whatever you have to the faire and we'll see who got lucky. <b>Prize for the best hand during the faire.</b></p>
      </div>
    <% } %>

    <!-- the hand you are building for the faire -->
    <% if(i){ %>
      <div class="tav-mark" id="hand"><span>🂡 The Cardsharp's Hand</span></div>
      <div class="tav-card tav-hand">
        <h3>Your hand<% if(handRank){ %> — <b class="tav-rank"><%= handRank.name %></b><% } %></h3>

        <div class="tav-cards">
          <% for(var n=0;n<5;n++){ var card = hand[n]; %>
            <% if(card){ %>
              <span class="pcard<%= card.red?' is-red':'' %>">
                <b class="pcard__r"><%= card.r==='T'?'10':card.r %></b>
                <span class="pcard__s"><%= card.glyph %></span>
              </span>
            <% } else { %>
              <span class="pcard is-empty" aria-label="empty slot"></span>
            <% } %>
          <% } %>
        </div>

        <% if(hand.length>=5){ %>
          <p class="muted">That's your five. Bring them to the faire and see how they stack up.</p>
        <% } else if(ration.canDraw){ %>
          <div class="tav-ration">
            <form method="post" action="/board/ration">
              <button class="tav-draw" type="submit"><span>Take<br>tonight's<br>card</span></button>
            </form>
            <div>
              <h3>There's a card here for you</h3>
              <p class="muted">One a night, just for stopping by. <b><%= 5-hand.length %></b> more to go if you keep turning up.</p>
            </div>
          </div>
        <% } else { %>
          <p class="muted">Taken for tonight<% if(i.streak){ %> · streak <%= i.streak %><% } %>. Come back tomorrow for the next card
            — <%= 5-hand.length %> still to come.</p>
        <% } %>

        <% if(hand.length<5){ %>
          <div class="tav-buy">
            <% if((i.coins||0) >= cardPrice){ %>
              <form method="post" action="/board/hand/buy">
                <button class="tav-buybtn" type="submit">Buy the next card — <%= cardPrice %> coins</button>
              </form>
              <span class="tav-buynote">You have <%= i.coins||0 %>. Impatient? The House will deal you one now.</span>
            <% } else { %>
              <span class="tav-buynote">A card off the House costs <%= cardPrice %> coins — you have <%= i.coins||0 %>.
                Turn up each night and the purse fills on its own.</span>
            <% } %>
          </div>
        <% } %>

        <% if(handRank){ %>
          <p class="tav-prize"><b>Show this hand at the faire</b> and <%= handPrizes[handRank.tier] %>.
            What the House is giving away stays a secret until you show it — find the Dealer at the House of Card and Coin.
            <% if(handRank.short){ %><br><span class="muted">You hold <%= hand.length %>. Come back for the rest —
              a straight or a flush needs all five.</span><% } %></p>
        <% } else { %>
          <p class="muted tav-prize-hint">Drop in each night and collect a card. Whatever you have when the gates open is what you play — no pressure.</p>
        <% } %>
      </div>
    <% } %>

  </div>

  <!-- ── speak ──────────────────────────────────────────────────────────── -->
  <div class="tav-dock" id="compose">
    <% if(i){ %>
      <form class="tav-bar" method="post" action="/board/thread">
        <input class="tav-body-in" name="body" placeholder="Say something to the House…" aria-label="Your message" required>
        <select name="category" aria-label="Which corner of the tavern">
          <% cats.forEach(function(c){ %><option value="<%= c %>"><%= c %></option><% }); %>
        </select>
        <button type="submit">Speak</button>
      </form>
      <details class="tav-pollnew">
        <summary>Put a question to the House instead</summary>
        <form method="post" action="/board/poll">
          <input name="question" placeholder="Your question" aria-label="Poll question" required>
          <input name="options" placeholder="Answer 1" aria-label="Answer 1" required>
          <input name="options" placeholder="Answer 2" aria-label="Answer 2" required>
          <input name="options" placeholder="Answer 3 (optional)" aria-label="Answer 3">
          <input name="options" placeholder="Answer 4 (optional)" aria-label="Answer 4">
          <button type="submit">Ask it</button>
        </form>
      </details>
    <% } else { %>
      <p class="tav-signin">
        Anyone may read the tavern. To speak, <a href="/tavern">claim a seat</a> — a name and a face is all it takes —
        or <a href="/members/login">sign in</a>.
      </p>
    <% } %>
  </div>
</div>

<script>
(function(){
  var cv=document.getElementById('tavFx'); if(!cv) return;
  var room=cv.closest('.tav-room');
  var reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* the hearth burns down as the room goes quiet */
  var quiet=parseInt(room.getAttribute('data-quiet'),10)||0;
  var heat=Math.max(0.30, 1 - Math.min(quiet,48)/48);

  var ctx=cv.getContext('2d'), W=0,H=0;
  function size(){
    var dpr=Math.min(window.devicePixelRatio||1,2), r=cv.getBoundingClientRect();
    W=r.width; H=r.height;
    cv.width=Math.round(W*dpr); cv.height=Math.round(H*dpr);
    ctx.setTransform(dpr,0,0,dpr,0,0);
  }
  size(); window.addEventListener('resize',size);

  var embers=[];
  function ember(){
    return {x:W*0.5+(Math.random()-0.5)*W*0.06, y:H*0.72,
            vy:-(0.2+Math.random()*0.65)*heat, vx:(Math.random()-0.5)*0.3,
            r:0.6+Math.random()*1.4, life:1};
  }
  for(var n=0;n<Math.round(24*heat);n++){var e=ember();e.y-=Math.random()*H*0.45;e.life=Math.random();embers.push(e);}

  function paint(t){
    ctx.clearRect(0,0,W,H);
    var fx=W*0.5, fy=H*0.72;
    var pulse=0.78+Math.sin(t*1.7)*0.07+Math.sin(t*3.9)*0.04;

    var pool=ctx.createRadialGradient(fx,fy,6,fx,fy,W*0.52*pulse);
    pool.addColorStop(0,'rgba(255,186,92,'+(0.50*heat)+')');
    pool.addColorStop(0.28,'rgba(210,132,44,'+(0.24*heat)+')');
    pool.addColorStop(0.62,'rgba(120,66,20,'+(0.10*heat)+')');
    pool.addColorStop(1,'rgba(0,0,0,0)');
    ctx.fillStyle=pool; ctx.fillRect(0,0,W,H);

    ctx.globalCompositeOperation='lighter';
    for(var k=0;k<5;k++){
      var ph=t*2.1+k*1.27;
      var h=H*(0.13+0.07*Math.abs(Math.sin(ph)))*heat;
      var w=W*(0.026+0.011*Math.abs(Math.cos(ph*0.8)));
      var ox=Math.sin(ph*1.3)*W*0.010;
      var g=ctx.createRadialGradient(fx+ox,fy-h*0.42,1,fx+ox,fy-h*0.42,Math.max(h,1));
      g.addColorStop(0,'rgba('+(k<2?'255,226,150':'244,150,50')+','+(0.58*heat)+')');
      g.addColorStop(0.5,'rgba(214,104,26,'+(0.20*heat)+')');
      g.addColorStop(1,'rgba(120,40,8,0)');
      ctx.fillStyle=g;
      ctx.beginPath(); ctx.ellipse(fx+ox,fy-h*0.42,w,h*0.68,0,0,Math.PI*2); ctx.fill();
    }
    for(var j=0;j<embers.length;j++){
      var p=embers[j];
      p.x+=p.vx; p.y+=p.vy; p.vy-=0.0016; p.life-=0.0055;
      if(p.life<=0||p.y<H*0.08){ embers[j]=ember(); continue; }
      ctx.globalAlpha=Math.max(0,p.life)*0.85;
      ctx.fillStyle=p.life>0.55?'#ffd489':'#d9772a';
      ctx.beginPath(); ctx.arc(p.x,p.y,p.r,0,Math.PI*2); ctx.fill();
    }
    ctx.globalAlpha=1; ctx.globalCompositeOperation='source-over';
  }

  if(reduce){ paint(0); }
  else{
    var t=0;
    (function loop(){ t+=0.045; paint(t); requestAnimationFrame(loop); })();
  }

  /* No auto-scroll: the room is the first thing you should see, and jumping
     past it to the newest line meant you never laid eyes on it. */

  /* Keep the last message clear of the docked composer. The dock is taller when
     signed out (it carries the sign-in note), so measure it rather than guess. */
  var dock=document.querySelector('.tav-dock'), logEl=document.querySelector('.tav-log');
  function clearDock(){
    if(!dock||!logEl) return;
    logEl.style.paddingBottom=(dock.getBoundingClientRect().height+26)+'px';
  }
  clearDock();
  window.addEventListener('resize',clearDock);
  if(window.ResizeObserver && dock) new ResizeObserver(clearDock).observe(dock);
})();
</script>

<script>
/* The doors bow out on their own — the animation ends hidden whatever happens
   here. This takes the node out of the page afterwards so nothing decorative
   is left lying over the Tavern, and lets an impatient hand cut it short. The
   timeout is the real safety net: if the animation never runs at all, the way
   in still clears. */
(function(){
  var door=document.querySelector('.tavdoor');
  if(!door||!document.documentElement.classList.contains('tav-enter'))return;
  function open(){ if(door&&door.parentNode){door.parentNode.removeChild(door);door=null;} }
  setTimeout(open,2400);
  ['click','keydown','touchstart','wheel'].forEach(function(ev){
    document.addEventListener(ev,open,{once:true,passive:true});
  });
})();
</script>


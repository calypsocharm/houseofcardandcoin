<%- include('_top',{title:'The Tavern',bodyClass:'tavern-page'}) %>
<div class="tavern-band"><%- include('_tavern-scene') %><div class="ticker" aria-hidden="true"><div class="ticker__track"><% threads.slice(0,10).forEach(function(t){ %><span class="tk">&#10022; <%= t.title %></span><% }); if(!threads.length){ %><span class="tk">&#10022; The board is quiet &mdash; pull up a stool and pin the first note</span><% } %><% threads.slice(0,10).forEach(function(t){ %><span class="tk">&#10022; <%= t.title %></span><% }); if(!threads.length){ %><span class="tk">&#10022; The board is quiet &mdash; pull up a stool and pin the first note</span><% } %></div></div></div><section class="section" style="padding-top:32px"><div class="container">
<div class="bannerhead"><span class="eyebrow" style="color:var(--gold-l)">The Tavern</span><h2 style="color:#f8edd1">Notice Board &amp; Polls</h2><div class="rule"></div></div>
<% if(gates){ %><div class="countdown"><% if(gates.ended){ %>&#9873; The faire has sailed on &mdash; thank you, one and all.<% } else if(gates.open){ %>&#9873; The gates are open! Find us at Sunset Park.<% } else { %>&#9873; The gates open in <b><%= gates.days %></b> <%= gates.days===1?'day':'days' %> &mdash; October 9&ndash;11, 2026<% } %></div><% } %>
<p class="lead">Pull up a stool. Read the notes, trade a deal, hitch a ride to camp, or put a question to the House. Anyone can read — to post, <% if(i){ %>you're seated as <b><%= i.name %></b> · &#129689; <b><%= i.coins %></b> doubloons &middot; <a href="/board/notices">&#128276;<% if(notices>0){ %> <b><%= notices %></b><% } %></a> &middot; <a href="/board/whispers">whispers</a> &middot; <a href="/tavern/logout">leave your seat</a><% } else { %><a href="/tavern">claim a seat</a> (a name + avatar)<% } %>.</p>
<p class="muted" style="margin:6px 0 0">Wanted, dead or alive &mdash; browse the <a href="/board/rogues">Rogues' Gallery</a>.</p>
<div class="grid grid--2" style="gap:18px;margin:22px 0">
<div class="compose" id="ration" style="margin:0"><h3>&#127183; Daily Rum Ration</h3><% if(!i){ %><p class="muted" style="margin:0"><a href="/tavern">Claim a seat</a> to draw your daily card.</p><% } else if(ration.canDraw){ %><% if(i.streak>0){ %><p class="muted" style="margin:0 0 12px">&#128293; You are on a <%= i.streak %>-day streak &mdash; keep it going.</p><% } %><p class="muted" style="margin:0 0 12px">One free draw a day &mdash; a fortune and a purse of doubloons.</p><form method="post" action="/board/ration"><button class="btn btn--gold">Draw a Card</button></form><% } else if(ration.card){ %><div class="rationshow"><div class="rationshow__card"><b><%= ration.card.n %></b><p style="margin:6px 0 0;font-style:italic"><%= ration.card.f %></p><span class="tag" style="margin-top:10px;display:inline-block">+<%= ration.card.c %> &#129689; doubloons</span><% if(ration.card.streak>1){ %><span class="tag" style="margin-top:10px;display:inline-block">&#128293; <%= ration.card.streak %>-day streak &middot; +<%= ration.card.bonus %> bonus</span><% } %></div><p class="muted" style="margin:10px 0 0">Come back tomorrow for another draw.</p></div><% } else { %><p class="muted" style="margin:0">Come back tomorrow for another draw.</p><% } %></div>
<div class="compose" style="margin:0"><h3>&#127769; Tavern Special of the Day</h3><p style="margin:0"><%= special %></p><% if(i){ %><a class="btn btn--outline" href="/board#compose" style="margin-top:12px">Answer this</a><% } else { %><p class="muted" style="margin:10px 0 0"><a href="/tavern">Claim a seat</a> to answer.</p><% } %></div>
</div><% if(q&&q.e){ %><div class="compose" style="border-color:var(--wine);color:var(--wine);margin:18px 0"><%= q.e %></div><% } %>
<% if(!i){ %>
<div class="compose" style="margin:26px 0"><h3>Want to post or vote?</h3><p class="muted" style="margin-top:0">Reading is free for all. To pin a note, reply, or raise a hand in a poll, <a href="/tavern">claim a seat at the tavern</a> — just a name, email, and a face (avatar). No guild invite needed.</p><a class="btn btn--gold" href="/tavern">Claim a Seat</a><p class="muted" style="margin-top:12px;font-size:.92rem">Already a guild member? <a href="/members/login">Sign in at the Guild Login</a> to post as yourself.</p></div>
<% } else { %>
<div class="compose" id="compose" style="margin:26px 0"><h3>Pin a Note</h3><form method="post" action="/board/thread"><div class="grid grid--2" style="gap:14px"><div class="field" style="margin:0"><label>Category</label><select name="category"><% cats.forEach(function(c){ %><option value="<%= c %>"><%= c %></option><% }) %></select></div><div class="field" style="margin:0"><label>Title</label><input name="title" required placeholder="A short headline"></div></div><div class="field"><label>Your note</label><textarea name="body" required placeholder="Say your piece..."></textarea></div><button class="btn btn--gold">Pin the Note</button></form></div>
<div class="compose" id="polls" style="margin:26px 0"><h3>Put a Question to the House</h3><form method="post" action="/board/poll"><div class="field"><label>Question</label><input name="question" required placeholder="Which night for the guild dinner?"></div><div class="field"><label>Options (at least 2)</label><input name="options" required placeholder="Saturday"><input name="options" required placeholder="Sunday" style="margin-top:8px"><input name="options" placeholder="Another..." style="margin-top:8px"></div><button class="btn btn--wine">Raise the Question</button></form></div>
<% } %>

<h3 style="color:#f8edd1;font-family:var(--display);margin:36px 0 10px">Polls to the House</h3>
<% if(!polls.length){ %><p class="muted">No questions raised yet.</p><% } %>
<% polls.forEach(function(p){ const total=p.total; %>
<div class="note" id="poll<%= p.id %>" style="margin-bottom:18px"><div style="display:flex;gap:14px;align-items:flex-start"><%- include('_avatar',{name:p.authorName,avatar:p.authorAvatar}) %><div style="flex:1;min-width:0"><div style="display:flex;gap:10px;align-items:baseline;flex-wrap:wrap"><b style="color:var(--wine);font-size:1.12rem"><%= p.question %></b><span class="muted" style="font-size:.78rem">by <%= p.authorName %> · <%= new Date(p.ts).toLocaleDateString() %></span></div>
<% p.options.forEach(function(o){ const pct=total?Math.round(o.votes.length/total*100):0; %>
<div style="margin-top:12px"><div style="display:flex;justify-content:space-between;font-size:.9rem;color:var(--ink2)"><span><%= o.text %></span><span class="muted"><%= o.votes.length %> · <%= pct %>%</span></div><div class="pollbar" style="width:<%= pct %>%;margin-top:4px"></div></div>
<% }); %>
<% if(i){ %><form method="post" action="/board/poll/<%= p.id %>/vote" style="margin-top:14px;display:flex;gap:8px;flex-wrap:wrap"><% p.options.forEach(function(o){ %><button class="btn btn--outline" name="option" value="<%= o.id %>" type="submit" style="padding:8px 14px;font-size:.7rem"><%= o.text %></button><% }); %></form><% if(p.voted){ %><span class="tag" style="margin-top:8px;display:inline-block">Your hand is raised</span><% } %><% } else { %><p class="muted" style="font-size:.82rem;margin-top:10px"><a href="/tavern">Claim a seat</a> to vote.</p><% } %>
<% if(leader){ %><form method="post" action="/board/poll/<%= p.id %>/delete" style="margin-top:12px"><button class="btn btn--wine" style="padding:6px 12px;font-size:.6rem">Strike the question</button></form><% } %>
</div></div></div>
<% }); %>

<h3 style="color:#f8edd1;font-family:var(--display);margin:36px 0 10px">Notes on the Board</h3><div class="tackboard">
<% if(!threads.length){ %><p class="muted">The board is bare. Be the first to pin a note.</p><% } %>
<% threads.forEach(function(t){ %>
<div class="note" style="margin-bottom:18px"><div style="display:flex;gap:14px;align-items:flex-start"><%- include('_avatar',{name:t.authorName,avatar:t.authorAvatar}) %><div style="flex:1;min-width:0"><div style="display:flex;gap:10px;align-items:baseline;flex-wrap:wrap"><span class="tag"><%= t.category %></span><a class="note__title" href="/board/thread/<%= t.id %>"><b><%= t.title %></b> <span class="note__open">open the messages &rarr;</span></a></div><p class="muted" style="font-size:.78rem;margin:2px 0 8px">by <%= t.authorName %> · <%= new Date(t.ts).toLocaleDateString() %> · <%= t.replies.length %> <%= t.replies.length===1?'reply':'replies' %></p><p style="color:var(--ink2);margin:0;white-space:pre-wrap"><%= t.body %></p><div style="margin-top:12px;display:flex;gap:8px;align-items:center;flex-wrap:wrap"><a href="/board/thread/<%= t.id %>" class="btn btn--outline" style="padding:6px 14px;font-size:.66rem">Open the thread &rarr;</a><% if(leader){ %><form method="post" action="/board/thread/<%= t.id %>/delete"><button class="btn btn--wine" style="padding:6px 12px;font-size:.6rem">Strike</button></form><% } %></div><%- include('_toasts',{i:i,reacts:t.reacts,action:'/board/thread/'+t.id+'/react'}) %></div></div></div>
<% }); %>
</div></div></section>
<%- include('_bot') %>
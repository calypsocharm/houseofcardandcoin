<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= typeof title!=='undefined'?title:'House of Card and Coin' %> — House of Card and Coin</title>
<meta name="description" content="<%= typeof desc!=='undefined'?desc:'A Renaissance Faire guild of dealers, readers, brokers and sellswords — the House of Card and Coin at the Age of Chivalry Renaissance Festival, Las Vegas.' %>">
<meta property="og:title" content="<%= typeof title!=='undefined'?title:'House of Card and Coin' %> — House of Card and Coin">
<meta property="og:description" content="<%= typeof desc!=='undefined'?desc:'A Renaissance Faire guild of dealers, readers, brokers and sellswords.' %>">
<%
  /* Open Graph requires ABSOLUTE image URLs — Facebook, Discord and iMessage
     will not resolve a root-relative path, so shared links previewed blank. */
  var _site='https://houseofcardandcoin.com';
  var _img=(typeof image!=='undefined'&&image)?image:'/assets/img/000.jpg';
  if(_img.charAt(0)==='/') _img=_site+_img;
  var _ttl=(typeof title!=='undefined'?title:'House of Card and Coin')+' — House of Card and Coin';
  var _dsc=(typeof desc!=='undefined'&&desc)?desc:'A Renaissance Faire guild of dealers, readers, brokers and sellswords.';
%>
<meta property="og:image" content="<%= _img %>">
<meta property="og:url" content="<%= typeof url!=='undefined'?url:_site+'/' %>">
<meta property="og:type" content="website">
<meta property="og:site_name" content="House of Card and Coin">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= _ttl %>">
<meta name="twitter:description" content="<%= _dsc %>">
<meta name="twitter:image" content="<%= _img %>">
<link rel="canonical" href="<%= typeof url!=='undefined'?url:_site+'/' %>">
<link rel="icon" href="/assets/img/019.png"><link rel="manifest" href="/manifest.webmanifest"><meta name="theme-color" content="#1a120b"><meta name="mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"><meta name="apple-mobile-web-app-title" content="The House"><link rel="apple-touch-icon" href="/assets/img/app/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/style.css?v=<%= typeof cssv!=='undefined'?cssv:'1' %>">
<%
  /* Set before first paint, not in nav.js, so the plain link row never flashes
     on its way to becoming the menu — and so a browser with scripting off is
     never given the class, and keeps the row it can actually use.
     __ME__ saves nav.js an /api/me round trip on the pages the server already
     knows the answer for. The < escape keeps a name containing markup from
     closing this script tag early. */
%>
<script>document.documentElement.className+=" js-nav";window.__ME__=<%- JSON.stringify(locals.me||{signedIn:false}).replace(/</g,'\\u003c') %>;</script>
<% if(locals.active==='board'){ %>
<%
  /* Decided here rather than in a deferred script so the doors are up before
     the first paint — otherwise you would see the Tavern for a frame and then
     have a door shut in your face.

     Once a day, which is the rhythm the Tavern is actually used at: people come
     of an evening to take their card, and that arrival is the moment worth
     opening the doors for. It was once a browser session, which turned out to
     be far rarer than intended — leave a tab open all week and you see it once.
     Coming back from another page in the same day does not replay it, so it
     never becomes a toll gate. ?enter=1 replays it whenever you want.

     The date is kept in localStorage, so it survives closing the browser; the
     old sessionStorage key is no longer read. Local dates on purpose — the day
     should turn over at your midnight, not UTC's. */
%>
<script>(function(){try{
  if(window.matchMedia('(prefers-reduced-motion:reduce)').matches)return;
  var d=new Date(), today=d.getFullYear()+'-'+(d.getMonth()+1)+'-'+d.getDate();
  if(!/[?&]enter=1/.test(location.search)&&localStorage.getItem('hocc-tavern-day')===today)return;
  localStorage.setItem('hocc-tavern-day',today);
  document.documentElement.className+=' tav-enter';
}catch(e){}})();</script>
<% } %>
</head><body<%- locals.bodyClass?(' class="'+bodyClass+'"'):'' %>>
<a class="skip-link" href="#main">Skip to content</a>
<header><div class="nav"><a class="brand" href="/index.html"><img class="crest" src="/assets/img/019.png" alt="House of Card and Coin crest"><span>House of Card and Coin<small>Whispers, Wagers, and Well-Kept Secrets</small></span></a>
<button class="menu-toggle" aria-label="Menu" onclick="document.getElementById('nl').classList.toggle('open')"><span></span><span></span><span></span></button>
<nav class="nav-links" id="nl"><a href="/index.html"<%= locals.active==='map'?' class="active"':'' %>>Home &middot; the Map</a><a href="/guild.html"<%= typeof active==='undefined'||active==='guild'?' class="active"':'' %>>Guild</a><a href="/events.html">Scroll of Events</a><a href="/weekend"<%= locals.active==='weekend'?' class="active"':'' %>>The Weekend</a><a href="/camp.html">Ren Faire Camp</a><a href="/board">Tavern</a><a href="/board/roll">Roll of Hands</a><a href="/gallery">Gallery</a><a href="/faq"<%= typeof active!=='undefined'&&active==='faq'?' class="active"':'' %>>FAQ</a><a href="/pigeon.html">Carrier Pigeon</a><% if(locals.u){ %><span class="signal signal--in" title="You are signed in as <%= u.name %>">● Signed in — <%= u.name %></span><% if(locals.unread){ %><a class="newsbell" href="/letters" title="<%= unread %> waiting in the Pigeon Post">✦ <%= unread %> new</a><% } %><a href="/card">Tonight&rsquo;s card</a><a href="/members">Profile</a><form method="post" action="/members/logout" class="nav-logout"><button type="submit" class="nav-login">Sign out</button></form><% } else if(locals.patron){ %><span class="signal signal--in" title="You have a seat in the tavern as <%= patron.name %>">● Seated — <%= patron.name %></span><% if(locals.unread){ %><a class="newsbell" href="/letters" title="<%= unread %> unread notice<%= unread===1?'':'s' %>">✦ <%= unread %> new</a><% } %><a href="/card">Tonight&rsquo;s card</a><a href="/board">Tavern</a><form method="post" action="/tavern/logout" class="nav-logout"><button type="submit" class="nav-login">Leave</button></form><% } else { %><span class="signal signal--out">● Signed out</span><a class="nav-login" href="/members/login">Guild Login</a><% } %></nav></div></header>
<main id="main" tabindex="-1">
<%- include('_top',{title:'A Map of the House',active:'map',desc:'Every corner of the House of Card and Coin drawn as a village — the guild, the tavern, the camp, the gallery. Press a place to walk in.',image:'/assets/img/og/index.jpg',url:'https://houseofcardandcoin.com/map'}) %>
<link rel="stylesheet" href="/assets/css/map.css?v=<%= typeof assetv!=='undefined'?assetv:'1' %>">

<%
  /* The site as a place rather than a menu.

     The artwork is a painted illustration; the clickable layer is separate
     from it. Hotspots are held as percentages of the image, not pixels, so
     the map scales from a phone to a desktop without any of them drifting
     off their building — and if the picture is ever redrawn, only these ten
     numbers change.

     x,y is the CENTRE of the hotspot, w,h its size, all in % of the image.
     Every one is a real <a>: keyboard reachable, middle-clickable, and
     announced properly to a screen reader. */
  /* spots come from tools/map-spots.json via the route, so this page and the
     homepage can never disagree about where a building is. */
%>

<section class="mapwrap"><div class="container">

  <% if(!hasArt){ %>
    <%
      /* The picture is not in place yet. Rather than a broken image, the page
         is simply the same ten doors as a list — and the Guild Leader is told
         exactly where to put the file. */
    %>
    <div class="bannerhead"><span class="eyebrow">&#9884; A Map of the House &#9884;</span>
      <h1>The Places of the House</h1><div class="rule"></div></div>
    <% if(locals.me && me.leader){ %>
      <div class="scroll mapmissing">
        <h3>The map artwork is not here yet</h3>
        <p>Save the painted map as <b>assets/img/shire-map.jpg</b> and this page becomes the
          picture, with every building clickable. Nothing else needs changing &mdash; the doors
          below are already wired to it.</p>
      </div>
    <% } %>
  <% } else { %>
    <div class="bannerhead"><span class="eyebrow">&#9884; A Map of the House &#9884;</span>
      <h1>Where Would You Like to Go?</h1><div class="rule"></div></div>
    <p class="maplead">Press a place to walk in.</p>

    <div class="mapframe">
      <img class="mapart" src="<%= art %>"
           alt="An illustrated map of this site drawn as a village: the House at the centre, with the Guild, the Tavern, the camp, the gallery and more around it."
           width="1456" height="1080">
      <%
        /* The ambient layer, from the same JSON the hotspots come from.
           Light rather than objects: the painting already holds a fire, a
           dovecote and a pigeon, so a second one drawn on top would read as
           a mistake. Firelight, lantern glow and a few embers instead. */
      %>
      <span class="mapfx" aria-hidden="true">
        <% (cfg.glow||[]).forEach(function(g){ %>
          <span class="mapglow mapglow--<%= g.kind %>"
                style="left:<%= g.x %>%;top:<%= g.y %>%;width:<%= g.r*2 %>%;padding-bottom:<%= g.r*2 %>%"></span>
        <% }) %>
        <% [[cfg.embers,0.55],[cfg.embers2,0.35]].forEach(function(pair){
             var em=pair[0]||{count:0}, spread=pair[1];
             for(var n=0;n<(em.count||0);n++){ var sway=((n%5)-2)*spread; %>
          <i class="mapember" style="left:<%= (em.x+sway).toFixed(2) %>%;top:<%= em.y %>%;animation-delay:<%= (n*0.34).toFixed(2) %>s;animation-duration:<%= (2.6+(n%5)*0.5).toFixed(1) %>s"></i>
        <%   }
           }) %>
      </span>
      <% spots.forEach(function(s){ %>
        <%
          /* The same aligned slice the generator writes into the homepage:
             the hotspot carries its own piece of the map, lined up exactly
             with the picture beneath, so on hover it can peel away as a
             sticker rather than a box drawn over the top. */
          var _sz=(10000/s.w).toFixed(2)+"% "+(10000/s.h).toFixed(2)+"%";
          var _px=((s.x-s.w/2)/(100-s.w)*100).toFixed(3);
          var _py=((s.y-s.h/2)/(100-s.h)*100).toFixed(3);
        %>
        <a class="mapspot" href="<%= s.href %>"
           style="left:<%= s.x %>%;top:<%= s.y %>%;width:<%= s.w %>%;height:<%= s.h %>%;background-image:url('<%= art %>');background-size:<%= _sz %>;background-position:<%= _px %>% <%= _py %>%"
           aria-label="<%= s.label %> — <%= s.sub %>">
          <span class="mapspot__tip"><b><%= s.label %></b><small><%= s.sub %></small></span>
        </a>
      <% }) %>
    </div>
  <% } %>

  <%
    /* The same ten doors as plain text under the picture. Not a fallback
       nobody sees — on a phone the hotspots are small, and some people would
       simply rather read a list. */
  %>
  <ul class="mapdoors">
    <% spots.forEach(function(s){ %>
      <li><a href="<%= s.href %>"><span class="mapdoors__n"><%= s.n %></span>
        <span><b><%= s.label %></b><small><%= s.sub %></small></span></a></li>
    <% }) %>
  </ul>

</div></section>

<script defer src="/assets/js/map-live.js?v=<%= typeof assetv!=='undefined'?assetv:'1' %>"></script>
<%- include('_bot') %>

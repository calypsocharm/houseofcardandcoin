<%- include('_top',{title:'The Guild',active:'guild',bodyClass:'guild-page',desc:'Meet the House of Card and Coin — dealers, readers, brokers and sellswords, plus the live guild roster with ranks, members, and camp bunks.',image:'/assets/img/og/guild.jpg',url:'https://houseofcardandcoin.com/guild.html'}) %>
<style>
/* A Pledge has an account but has not been accepted into the guild yet. */
.member--pledge{opacity:.9;border-style:dashed;border-color:var(--gold-d)}
.member--pledge .role{color:var(--wine);font-weight:600;letter-spacing:.06em}
.member--pledge .avatar{filter:grayscale(.35)}
</style>
<%
  /* The header is the guild's own motion graphic rather than a photograph
     behind a wash of dark.

     It cannot be treated as a background the way the other page heroes are.
     It carries its own typography — the crest, the four classes, and the very
     line this page's opening paragraph used to say — so laying the page's
     heading over it would put two sets of words in the same place and hide
     both. It gets the band to itself, and the heading sits underneath.

     "Where chance, destiny, and deals align" is gone from the paragraph below
     for the same reason: the film says it, in gold, a few inches above.

     Same data-src as every other video on the site, so hero-video.js decides
     whether it is worth downloading. A phone, a metered connection or anyone
     who asked for less motion gets the still — and because the still is the
     frame with all four classes on it, they lose the movement and none of the
     message. */
%>
<section class="pagehero pagehero--film">
  <div class="container pagehero__filmrow">
    <video class="pagehero__film" muted loop playsinline preload="none"
           poster="/assets/img/guild-film.jpg" data-src="/assets/vid-guild.mp4"
           aria-label="The House of Card and Coin — a consortium of specialists: the Dealer, the Reader, the Broker and the Sellsword">
      <img src="/assets/img/guild-film.jpg" alt="The House of Card and Coin and its four classes — the Dealer of Dares and Delights, the Reader of Inner Trails, the Broker of Balanced Bargains, and the Sellsword at the Door">
    </video>
    <div class="pagehero__inner">
      <span class="eyebrow">The Guild</span>
      <h1>Welcome to the House of Card and Coin</h1>
      <p>A gathering of specialists dedicated to life&rsquo;s more artful pursuits.</p>
    </div>
  </div>
</section>
<section class="section"><div class="container"><div class="bannerhead"><span class="eyebrow">⚜ Guild Roster ⚜</span><h2>The House, Assembled</h2><div class="rule"></div></div><% if(comingCount){ %><p class="lead center" style="margin-bottom:28px"><b style="color:var(--forest);font-size:1.2rem"><%= comingCount %></b> guildmate<%= comingCount>1?'s':'' %> marked as coming to the 2026 Faire.</p><% } %>
<% if(members.length){ %><div class="roster"><% members.forEach(function(m){ %>
<a class="member<%= m.title==='Guild Leader'?' member--lead':'' %><%= m.pledge?' member--pledge':'' %><%= m.ace?' member--ace':'' %>" href="/guild/<%= m.slug %>" title="<%= m.pledge?'A pledge — awaiting acceptance into the House. See their page':'See '+m.name+'’s page' %>"><% if(m.avatar){ %><img src="<%= m.avatar %>" class="member__avatar" alt="<%= m.name %>"><% } else { %><div class="avatar"><%= m.name.slice(0,2).toUpperCase() %></div><% } %><%
  /* Pinned across the bottom of the face: the best hand anybody has held since
     the game began, which is the contest that stands until the faire. The rank
     and where it was made go in the title rather than the ribbon — the card is
     narrow, and "High Hand" is the part anyone scanning the roster wants. */
%><% if(m.ace){ %><span class="member__ace" title="<%= m.aceShared?'Level on the high hand of the run so far':'The high hand of the run so far' %> — <%= m.aceRank %>, made in <%= m.ace %>">✦ <%= m.aceShared?'Joint High Hand':'High Hand' %></span><% } %><h3><%= m.name %></h3><span class="role"><%= m.rank %><% if(m.class){ %> &middot; <%= m.class %><% } %></span><% if(m.rsvp){ %><span class="member__coming">✓ Coming</span><% } %><% if(m.faires){ %><span class="member__faires"><%= m.faires %> faire<%= m.faires>1?'s':'' %> camped</span><% } else { %><span class="member__faires">Newly sworn</span><% } %><% if(m.bunks.length){ %><span class="member__bunks">Bunked: <%= m.bunks.join('; ') %></span><% } %></a>
<% }) %></div><% } else { %><p class="muted center">The roster fills as guildmates join the Hall.</p><% } %>
<p class="muted center" style="margin-top:24px">Want your portrait on the board? <a href="/members/login" style="color:var(--gold-d);font-weight:600">Sign in</a> to set your class, your face and your own page, and to claim a bunk.</p>
<%
  /* hero-video.js lives in the two static pages that had videos; this is the
     first rendered page to want one, so it has to ask for the script itself.
     Nothing downloads until that script decides the connection can afford it. */
%>
<script defer src="/assets/js/hero-video.js?v=<%= typeof assetv!=='undefined'?assetv:'1' %>"></script>
</div></section>
<section class="section" id="bunks"><div class="container"><div class="bannerhead"><span class="eyebrow">⚜ Camp Bunks ⚜</span><h2>Who Is in Which Bunk</h2><div class="rule"></div></div><p class="lead center" style="margin-bottom:22px">Two berths are spoken for all weekend;
  the other <b>three are open each night</b> &mdash; guildmates, claim yours under Profile.</p>
<% if(berths.length){ %>
<div class="berths">
  <p class="berths__lbl">Kept berths</p>
  <div class="berths__row">
  <% berths.forEach(function(b){ %>
    <div class="berth">
      <%- include("_avatar",{name:b.who,avatar:b.avatar,slug:b.slug}) %>
      <span class="berth__who"><b><%= b.who %></b><small><%= b.berth %></small></span>
    </div>
  <% }) %>
  </div>
</div>
<% } %><div class="grid grid--3"><% bunkBoard.forEach(function(d){ %><div class="day"><div class="day__hd"><span class="d"><%= d.night %></span><span class="h">3 bunks</span></div><div class="day__bd"><% d.bunks.forEach(function(b){ %><div class="event"><span class="t">Bunk <%= b.bunk %><% if(b.note){ %> <small class="bunknote"><%= b.note %></small><% } %></span><span class="b"><% if(b.taken){ %><b style="color:var(--wine)"><%= b.who?b.who.name:'a guildmate' %></b><% } else { %><span class="muted">Open</span><% } %></span></div><% }) %></div></div><% }) %></div></div></section><section class="section section--parch2" id="specialists"><div class="container"><div class="bannerhead"><span class="eyebrow">A Consortium of Specialists</span><h2>Where Chance, Destiny &amp; Deals Align</h2><div class="rule"></div></div>
<p class="lead center" style="margin-bottom:40px">Greetings, discerning Faire-goer! If you find yourself drawn to the more intriguing corners of the marketplace — where wit is as valuable as coin and opportunity often wears a disguise — you've found your way to us.</p>
<div class="grid grid--2">
<div class="scroll"><h3>🃏 The Dealer of Dares &amp; Delights</h3><p>Step up to the table of our resident card maestro. Whether you crave the thrill of a game of chance, a test of your strategic mind, or simply an amusing diversion, you'll find it here. Expect lively play and sharp wits.</p><%- include('_classfolk',{folk:byClass['Dealer'],what:'Dealer'}) %></div>
<div class="scroll"><h3>🔮 The Interpreter of Inner Trails</h3><p>Curious about what the threads of fate may hold? Our gifted tarot reader offers consultations to illuminate your path, explore your questions, and offer fresh perspectives from the ancient wisdom of the cards.</p><%- include('_classfolk',{folk:byClass['Reader'],what:'Reader'}) %></div>
<div class="scroll"><h3>🪙 The Broker of Balanced Bargains</h3><p>In a world of grand gestures, the most valuable things are found in carefully crafted agreements. Our astute broker facilitates unique transactions and keeps all ledgers — visible and invisible — meticulously kept.</p><%- include('_classfolk',{folk:byClass['Broker'],what:'Broker'}) %></div>
<div class="scroll"><h3>⚔️ The Sellsword at the Door</h3><p>Every table needs someone watching it. Our company keeps the peace around the House &mdash; adaptable, discreet, and bound by the bargain. When a deal goes sideways or the unexpected comes knocking, send for the sellsword. <a href="/treaty.html" style="color:var(--wine);font-weight:600">Treaty &amp; terms</a>.</p><%- include('_classfolk',{folk:byClass['Sellsword'],what:'Sellsword'}) %></div>
</div></div></section>
<section class="section"><div class="container"><div class="grid grid--2" style="align-items:center"><div><span class="eyebrow">The Gambits &amp; Games Arena</span><h2>Memorable Encounters &amp; Unique Discoveries</h2><p class="lead">We believe an unparalleled Renaissance Faire experience is built on memorable encounters and unique discoveries — a chance to engage, to be intrigued, and perhaps to walk away with more than you bargained for.</p><a class="btn btn--wine" href="/events.html" style="margin-top:22px">See the Schedule</a></div>
<div><figure class="fig fig--43"><img src="/assets/img/014.jpg" alt="Guildmates in the marketplace" loading="lazy"><figcaption>Guildmates in the marketplace</figcaption></figure></div></div></div></section>
<section class="section section--parch2" id="ranks"><div class="container"><div class="bannerhead"><span class="eyebrow">⚜ Guild Rank Paths ⚜</span><h2>From Pledge to Elder</h2><div class="rule"></div></div>
<p class="lead center" style="margin-bottom:18px">All hail the Guild Leader, <b>Sir Caberk</b>, and the Guild Elder, <b>Mama Bear</b>. Your rank rises with the number of faires you've camped with the House.</p>
<p class="lead center" style="margin-bottom:40px;font-size:1rem">Anyone may make an account and stand as a <b style="color:var(--wine)">Pledge</b>. The Guild Leader accepts pledges into the House, and only then does the rank ladder below begin.</p>
<div class="grid grid--4">
<div class="rank"><h3>1 · Pledge</h3><p>Signed up, awaiting the Guild Leader's welcome into the House.</p></div>
<div class="rank"><h3>2 · Guildmate</h3><p>Accepted and sworn to the House — newly welcomed, or a faire or two in.</p></div>
<div class="rank"><h3>3 · Veteran</h3><p>3+ faires — a seasoned hand around the campfire.</p></div>
<div class="rank"><h3>4 · Elder</h3><p>6+ faires — a keeper of the House's tales and traditions.</p></div>
</div></div></section>
<section class="section section--dark"><div class="container cta"><div><span class="eyebrow">Join the House</span><h2>Put me on the list!</h2><p>Quests, trading, tales, and a seat by the campfire await. Send your pigeon and claim your place in the House of Card and Coin.</p></div><div class="cta__actions"><a class="btn btn--gold" href="/pigeon.html">Send a Pigeon</a><a class="btn btn--ghost" href="/events.html">Scroll of Events</a></div></div></section>
<%- include('_bot') %>
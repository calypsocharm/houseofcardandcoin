<%- include('_top',{title:"Rogues' Gallery",bodyClass:'tavern-page'}) %>
<section class="section" style="padding-top:120px"><div class="container">
<div class="bannerhead"><span class="eyebrow" style="color:var(--gold-l)">The Tavern</span><h2 style="color:#f8edd1">Rogues' Gallery</h2><div class="rule"></div></div>
<p class="lead">Wanted, dead or alive. Every soul who's pulled up a stool &mdash; their portrait, their deeds, and the bounty on their head.</p>
<a class="btn btn--outline" href="/board" style="margin:18px 0">&larr; Back to the board</a>
<div class="grid grid--3" style="margin-top:10px">
<% rogues.forEach(function(r){ %>
<div class="wanted"><div class="wanted__stamp">WANTED</div><div class="wanted__portrait"><% if(r.slug){ %><a href="/guild/<%= r.slug %>" title="<%= r.name %>’s page"><%- include('_avatar',{name:r.name,avatar:r.avatar}) %></a><% } else { %><%- include('_avatar',{name:r.name,avatar:r.avatar}) %><% } %></div><h3 class="wanted__name"><% if(r.slug){ %><a href="/guild/<%= r.slug %>" class="tav-namelink"><%= r.name %></a><% } else { %><%= r.name %><% } %></h3><div class="wanted__title"><%= r.title %><% if(r.leader){ %> &middot; Guild Leader<% } %></div><div class="wanted__bounty">BOUNTY <b><%= r.coins %></b> &#129689;</div><ul class="wanted__deeds"><li><b><%= r.posts %></b> notes &amp; replies</li><% if(r.streak>1){ %><li>&#128293; <%= r.streak %>-day streak</li><% } %><% if(r.posts===0){ %><li>yet to make their mark</li><% } %></ul><% if(i&&!(i.t===r.t&&i.id===r.id)){ %><a class="btn btn--outline whisper-btn" href="/letters/<%= r.t %>/<%= r.id %>">Write to them</a><% } %></div>
<% }) %>
</div></div></section>
<%- include('_bot') %>
<%- include('_top',{title:'The Weekend',active:'weekend',desc:'Everything about the House of Card and Coin at the Age of Chivalry — who is coming, who sleeps where, what is still wanted, and when the gates open.',image:'/assets/img/og/camp.jpg',url:'https://houseofcardandcoin.com/weekend'}) %>
<link rel="stylesheet" href="/assets/css/weekend.css?v=<%= typeof assetv!=='undefined'?assetv:'1' %>">

<section class="pagehero"><div class="pagehero__bg" style="background-image:url('/assets/img/020.jpg')"></div>
<div class="container pagehero__inner"><span class="eyebrow">⚜ October 9 – 11, 2026 ⚜</span>
<h1>The Weekend</h1>
<p>Who is coming, who sleeps where, what is still wanted, and when the gates open. Everything in one place.</p>
<p class="wk-clock"><span class="chip chip--count" id="gatesCountdown" hidden></span>
  <span class="chip chip--note" data-gates-note hidden></span></p>
</div></section>

<section class="section"><div class="container" style="max-width:960px">

  <!-- ── who to ring on the day ────────────────────────────────────────── -->
  <%
    /* Signed-in members only. `day` is null for everyone else, so a stranger
       reading the weekend page never sees a phone number. */
  %>
  <%
    /* This used to be a banner across the top of the page. It did not need to
       be — the day you need it you will go looking, and until then it is just
       a siren over the bring-list. It lives in the FAQ now; this is the
       signpost. */
  %>
  <% if(day && day.mine && !day.phone){ %>
    <p class="wk-ring wk-ring--empty">📞 <b>No number on file for the day.</b> Guildmates have no way to
      reach you from the car park. Add one under <a href="/members#profile">your tabard</a> and it
      appears in the <a href="/faq#reaching">FAQ</a> for sworn guildmates only.</p>
  <% } %>

  <!-- ── the three numbers worth knowing at a glance ───────────────────── -->
  <div class="wk-stats">
    <div class="wk-stat wk-stat--folk"><i aria-hidden="true">🙋</i><b><%= coming.length %></b><span>coming</span></div>
    <div class="wk-stat wk-stat--bunk"><i aria-hidden="true">🛏️</i><b><%= bunksLeft %></b><span>bunk<%= bunksLeft===1?'':'s' %> open</span></div>
    <div class="wk-stat wk-stat--want<%= wanted.length?'':' is-done' %>"><i aria-hidden="true"><%= wanted.length?'🎒':'✅' %></i><b><%= wanted.length %></b><span>still wanted</span></div>
  </div>

  <!-- ── still wanted, which the bring-list never led with ─────────────── -->
  <div class="wk-block wk-block--want">
    <h2><i aria-hidden="true">🎒</i> Still wanted</h2>
    <% if(wanted.length){ %>
      <p class="wk-lead">Nobody is counting, but these are the gaps. Claim one under
        <a href="/members#bring">Profile</a>.<% if(covered){ %>
        <span class="wk-covered">✅ <%= covered %> of <%= items %> already covered.</span><% } %></p>
      <ul class="wk-wanted">
        <% wanted.forEach(function(w){ %>
          <li<%= w.claimed?' class="is-part"':'' %>>
            <span class="wk-wanted__i" aria-hidden="true"><%= w.icon %></span>
            <span class="wk-wanted__n"><%= w.remaining %></span>
            <span class="wk-wanted__w"><%= w.name %>
              <% if(w.claimed){ %>
                <span class="wk-bar"><span class="wk-bar__f" style="width:<%= Math.round(w.claimed/w.need*100) %>%"></span></span>
              <% } %>
            </span>
            <% if(w.claimed){ %><small><%= w.claimed %> of <%= w.need %> spoken for</small><% } %></li>
        <% }) %>
      </ul>
    <% } else { %>
      <p class="wk-lead wk-done">🎉 Every last thing on the list is spoken for. <%= items %> of <%= items %>.</p>
    <% } %>
  </div>

  <!-- ── who is coming ─────────────────────────────────────────────────── -->
  <div class="wk-block wk-block--folk">
    <h2><i aria-hidden="true">🙋</i> Coming</h2>
    <% if(coming.length){ %>
      <div class="wk-folk">
        <% coming.forEach(function(c){ %>
          <div class="wk-person">
            <%- include('_avatar',{name:c.name,avatar:c.avatar,slug:c.slug}) %>
            <span><b><% if(c.slug){ %><a href="/guild/<%= c.slug %>"><%= c.name %></a><% } else { %><%= c.name %><% } %></b><small><%= c.rank %></small></span>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <p class="wk-lead">Nobody has said yet. Mark yourself under <a href="/members#rsvp">Profile</a>.</p>
    <% } %>
  </div>

  <!-- ── what actually happens when you pull up ────────────────────────── -->
  <%
    /* Every piece of this already existed, spread across the camp page, the
       gates block and the faire's own FAQ. Nobody arriving for the first time
       was going to assemble it themselves in a hot car park. */
  %>
  <div class="wk-block wk-block--come">
    <h2><i aria-hidden="true">🚗</i> When you arrive</h2>
    <ol class="wk-steps">
      <li><b>Drive to the camping entrance</b>, not the main box office. It is the far left
        of the faire map &mdash; the <a href="/camp.html#parking">camp page</a> marks our site
        with an X.</li>
      <li><b>Park in the regular lots</b>, first come first served. Come early on the Friday:
        the lots at the camping end are the small ones.</li>
      <li><b>Show the QR code and get banded.</b> The faire sends one code per campground; you
        present it on arrival and everyone in the party gets a wristband.</li>
      <li><b>That wristband is your way in.</b> Show it at the RV campsite gate from then on.
        <b>Do not buy a ticket</b> &mdash; the band already covers your day, and people have
        paid twice.</li>
      <li><b>Find the rig and put your bedding down.</b> Bunks are claimed here on the site
        beforehand, so know which night is yours before you set off.</li>
    </ol>
  </div>

  <!-- ── who sleeps where ──────────────────────────────────────────────── -->
  <div class="wk-block wk-block--bunk">
    <h2><i aria-hidden="true">🛏️</i> Who sleeps where</h2>
    <% if(berths.length){ %>
      <p class="wk-lead">Two berths are spoken for all weekend — <%= berths.map(function(b){return b.who;}).join(' and ') %>.
        The three below are open each night.</p>
    <% } %>
    <div class="wk-nights">
      <% board.forEach(function(d){ %>
        <div class="wk-night">
          <p class="wk-night__h"><i aria-hidden="true">🌙</i> <%= d.night %></p>
          <% d.bunks.forEach(function(b){ %>
            <div class="wk-bunk<%= b.taken?' is-taken':'' %>">
              <span class="wk-bunk__n">Bunk <%= b.bunk %><% if(b.note){ %> <small class="bunknote"><%= b.note %></small><% } %></span>
              <% if(b.taken && b.who){ %>
                <span class="wk-bunk__who">
                  <%- include('_avatar',{name:b.who.name,avatar:b.who.avatar,slug:b.who.slug}) %>
                  <% if(b.who.slug){ %><a href="/guild/<%= b.who.slug %>"><%= b.who.name %></a><% } else { %><%= b.who.name %><% } %>
                </span>
              <% } else { %>
                <span class="wk-bunk__open">Open</span>
              <% } %>
            </div>
          <% }) %>
        </div>
      <% }) %>
    </div>
    <div class="wk-map">
      <a href="/camp.html#map" class="wk-map__pic"><img src="/assets/img/camp-screenshot.jpg"
        alt="Map of the faire grounds" loading="lazy"><span>🗺️ Where to drive</span></a>
      <p class="wk-note">Bunks are for guildmates who have already camped a faire, one bed per person per night,
        first come first served. Claim yours under <a href="/members#bunks">Profile</a>.<br>
        Head for the <b>camping entrance on the far left of the map</b> &mdash; the
        <a href="/camp.html#map">Ren Faire Camp</a> page marks our site with an X.</p>
    </div>
  </div>

  <!-- ── the gates ─────────────────────────────────────────────────────── -->
  <div class="wk-block">
    <h2><i aria-hidden="true">🎪</i> Gates</h2>
    <ul class="wk-gates">
      <li><b><i aria-hidden="true">🌅</i> Friday, Oct 9</b><span>10 a.m. – 10 p.m.</span></li>
      <li><b><i aria-hidden="true">☀️</i> Saturday, Oct 10</b><span>10 a.m. – 10 p.m.</span></li>
      <li class="is-short"><b><i aria-hidden="true">🌇</i> Sunday, Oct 11</b><span>10 a.m. – <b>5 p.m.</b></span></li>
    </ul>
    <p class="wk-band"><b>🎟️ If you hold a bunk you have a wristband, and the wristband is your way in
      from the camping area.</b> Do not buy a ticket you already have.</p>
    <p class="wk-note">Box office, gate procedures and what the faire will not let in are on the
      <a href="/camp.html#faire">Ren Faire Camp</a> page.<br>
      Lost, late or stuck on the day? <a href="/faq#reaching">How to reach the House</a>.</p>
  </div>

</div></section>

<%- include('_bot') %>

<%- include('_top',{title:'Profile',u:u}) %>
<% if(typeof err!=="undefined"&&err){ %><div class="container" style="max-width:600px;margin:90px auto 0"><div class="scroll" style="border-color:var(--wine);color:var(--wine)"><%= err %></div></div><% } %>
<% if(typeof q!=="undefined" && q.new && u.pledge){ %>
<section class="section" style="padding-top:118px;padding-bottom:0"><div class="container" style="max-width:720px">
  <div class="pledgewelcome">
    <span class="pledgewelcome__mark">✦</span>
    <h2>Welcome to the House, <%= u.name %></h2>
    <p class="pledgewelcome__lead">Your account is made. You stand as a <b>Pledge</b> — one step from the fire.</p>
    <div class="pledgewelcome__cols">
      <div>
        <h3>What you can do now</h3>
        <ul>
          <li>Talk in the Tavern and put questions to the House</li>
          <li>Take a card each night toward your hand for the faire</li>
          <li>Claim items off the camp bring-list</li>
          <li>Set your name, your face and your class below</li>
        </ul>
      </div>
      <div>
        <h3>What comes if the House takes you in</h3>
        <ul>
          <li>A place at camp, and the right to claim a bunk once you have camped a faire with us</li>
          <li>Your rank on the public guild roster</li>
          <li>The run of the House</li>
        </ul>
      </div>
    </div>
    <p class="pledgewelcome__foot"><b>The Guild Leader considers pledges one at a time, by hand.</b>
      It is not automatic and it is not owed — the House is small and the camp smaller. You don't
      need to ask or chase; sign in whenever you like, talk in the Tavern, and if you are taken in
      a <span class="pledgewelcome__pip">✦ new</span> mark appears in the bar at the top of every
      page telling you so.</p>
  </div>
</div></section>
<% } %>
<%- include('_after',{over:over,finest:finest}) %>
<%
  /* What has happened since you last stood here. Drawn only when there is
     something to say — a line reading "nothing new" every day teaches people
     to stop reading the line. The card prompt rides along with it, because on
     a quiet day that is the one thing still worth doing. */
  var _away = "";
  if(away > 0){
    var _h = Math.floor(away/3600000), _d = Math.floor(_h/24);
    _away = _d >= 1 ? (_d === 1 ? "since yesterday" : "in the last " + _d + " days")
          : _h >= 1 ? (_h === 1 ? "in the last hour" : "in the last " + _h + " hours")
          : "just now";
  }
%>
<% if(since.length || cardWaiting){ %>
<section class="section since"><div class="container">
  <div class="since__box">
    <p class="since__h">While you were away<% if(_away && since.length){ %> <span><%= _away %></span><% } %></p>
    <ul class="since__list">
      <% since.forEach(function(s){ %>
        <li><a class="since__item<%= s.gold ? " is-gold" : "" %>" href="<%= s.go %>">
          <b><%= s.n %></b><span><%= s.say %></span></a></li>
      <% }) %>
      <% if(cardWaiting){ %>
        <li><a class="since__item is-card" href="/board#hand">
          <b>&#127183;</b><span>tonight&rsquo;s card is waiting</span></a></li>
      <% } %>
    </ul>
  </div>
</div></section>
<% } %>
<%- include("_myweekend",{mine:mine}) %>
<%
  /* Yours, not the guild's. The bring-list further down is what the camp needs;
     this is what you need, and it is the one nobody is told about. */
  var _packed = pack.filter(function(x){ return x.done; }).length;
%>
<%
  /* Yours alone, and only drawn for a leader. Most of these are questions, so
     each one takes an answer as well as a tick — it is not settled when it is
     ticked, it is settled when it says a name. */
%>
<% if(chores){ %>
<section class="section sort" id="sort"><div class="container">
  <div class="bannerhead">
    <span class="eyebrow">&#9884; The Elder&rsquo;s Own &#9884;</span>
    <h2>Still to Sort</h2>
    <div class="rule"></div>
  </div>
  <p class="lead center sort__lead">The things nobody else can answer. Nobody else can see this
    either &mdash; not the guild, not the other leader.</p>
  <p class="sort__count"><b><%= chores.filter(function(x){return x.done;}).length %></b> of <%= chores.length %> settled</p>

  <ul class="sort__list">
    <% chores.forEach(function(it){ %>
      <li class="sort__item<%= it.done ? " is-done" : "" %>">
        <form method="post" action="/members/chores" class="sort__tick">
          <input type="hidden" name="id" value="<%= it.id %>">
          <button type="submit" aria-label="<%= it.done ? "Mark unsettled" : "Mark settled" %>: <%= it.what %>"><%- it.done ? "&#10003;" : "&nbsp;" %></button>
        </form>
        <div class="sort__body">
          <p class="sort__what"><%= it.what %>
            <% if(it.why){ %><small><%= it.why %></small><% } %></p>
          <form method="post" action="/members/chores" class="sort__answer">
            <input type="hidden" name="id" value="<%= it.id %>">
            <input name="answer" value="<%= it.answer || "" %>" maxlength="160"
                   placeholder="the answer, when you have it&hellip;"
                   aria-label="Answer for: <%= it.what %>">
            <button type="submit">Note it</button>
          </form>
        </div>
        <form method="post" action="/members/chores" class="sort__x">
          <input type="hidden" name="id" value="<%= it.id %>">
          <button type="submit" name="remove" value="1" title="Take it off the list" aria-label="Remove <%= it.what %>">&times;</button>
        </form>
      </li>
    <% }) %>
  </ul>

  <form method="post" action="/members/chores" class="sort__add">
    <input name="add" maxlength="120" placeholder="Something else you have to sort&hellip;" aria-label="Add something to your list">
    <button class="btn btn--gold" type="submit">Add</button>
  </form>
</div></section>
<% } %>
<section class="section section--parch2 pack" id="pack"><div class="container">
  <div class="bannerhead">
    <span class="eyebrow">&#9884; Yours to Bring &#9884;</span>
    <h2>What to Pack</h2>
    <div class="rule"></div>
  </div>
  <p class="lead center pack__lead">The bring-list below is the camp&rsquo;s. This one is yours,
    and nobody else can see it. Tick as you pack, strike anything that is not you, add whatever
    is only yours.</p>
  <p class="pack__count"><b><%= _packed %></b> of <%= pack.length %> packed</p>

  <ul class="pack__list">
    <% pack.forEach(function(it){ %>
      <li class="pack__item<%= it.done ? " is-done" : "" %>">
        <form method="post" action="/members/pack" class="pack__tick">
          <input type="hidden" name="id" value="<%= it.id %>">
          <button type="submit" aria-label="<%= it.done ? "Mark not packed" : "Mark packed" %>: <%= it.what %>"><%- it.done ? "&#10003;" : "&nbsp;" %></button>
        </form>
        <span class="pack__what"><%= it.what %>
          <% if(it.why){ %><small><%= it.why %></small><% } %></span>
        <form method="post" action="/members/pack" class="pack__x">
          <input type="hidden" name="id" value="<%= it.id %>">
          <button type="submit" name="remove" value="1" title="Take it off your list" aria-label="Remove <%= it.what %>">&times;</button>
        </form>
      </li>
    <% }) %>
  </ul>

  <form method="post" action="/members/pack" class="pack__add">
    <input name="add" maxlength="80" placeholder="Something only you need&hellip;" aria-label="Add something to your packing list">
    <button class="btn btn--gold" type="submit">Add</button>
  </form>
  <form method="post" action="/members/pack" class="pack__reset">
    <button type="submit" name="reset" value="1" onclick="return confirm('Start the list again from the House\u2019s? Anything you added is lost.')">Start it again</button>
  </form>
</div></section>

<section class="section section--parch2" style="padding-top:120px"><div class="container"><div class="bannerhead"><span class="eyebrow">Your Profile</span><h2>Welcome, <%= u.name %></h2><div class="rule"></div></div>
<div style="display:flex;gap:18px;align-items:center;flex-wrap:wrap;justify-content:center"><a href="/guild/<%= mySlug %>" title="Your page" class="facelink"><% if(u.avatar){ %><img src="<%= u.avatar %>" style="width:96px;height:96px;border-radius:50%;border:3px solid var(--gold);object-fit:cover"><% } else { %><div class="member" style="padding:0;background:transparent;border:0;box-shadow:none"><div class="avatar"><%= u.name.slice(0,2).toUpperCase() %></div></div><% } %></a><div style="text-align:center"><div style="font-family:var(--display);font-size:1.2rem;color:var(--wine)"><%= rank %></div><div class="muted"><% if(u.class){ %>Class: <b><%= u.class %></b> &middot; <% } %>Faires with the guild: <b><%= u.faires %></b></div></div></div>
</div></section>

<section class="section" id="profile"><div class="container"><div class="bannerhead"><span class="eyebrow">Your Tabard</span><h2>Profile &amp; Rank</h2><div class="rule"></div></div><% if(typeof q!=="undefined"){ %><% if(q.pw==="ok"){ %><div class="alert alert--ok" style="max-width:760px;margin:0 auto 18px">Password updated.</div><% } %><% if(q.pw==="bad"){ %><div class="alert alert--bad" style="max-width:760px;margin:0 auto 18px">Current password was wrong.</div><% } %><% if(q.pw==="short"){ %><div class="alert alert--bad" style="max-width:760px;margin:0 auto 18px">New password must be at least 6 characters.</div><% } %><% } %>
<div class="grid grid--3"><div class="scroll"><h3>Update Your Tabard</h3><form method="post" action="/members/profile" enctype="multipart/form-data">
<div class="field"><label>Your name <span class="muted" style="font-weight:400">(how the guild sees you on the roster)</span></label><input name="name" value="<%= u.name %>" autocomplete="name" required></div>
<div class="field"><label>Choose your class</label><select name="class"><option value="">— pick a class —</option><% classes.forEach(function(c){ %><option value="<%= c %>" <%= u.class===c?'selected':'' %>><%= c %></option><% }) %></select><p class="muted" style="margin:6px 0 0;font-size:.86rem">Dealer, reader, broker or sellsword — your name then stands under that trade on the <a href="/guild.html#specialists" style="color:var(--wine);font-weight:600">Guild page</a>.</p></div>
<div class="field"><label>Ren faires attended with the guild</label><p class="muted" style="margin:0;font-size:.88rem"><b><%= u.faires %></b> — set by the Guild Leader<% if(u.pledge){ %>, once you're accepted into the guild<% } %>.</p></div>
<div class="field"><label>Your face <span class="muted" style="font-weight:400">(this is exactly how it will appear)</span></label>
<div class="cropper" id="cropper" data-current="<%= u.avatar||'' %>">
  <div class="cropper__stage">
    <canvas id="cropCanvas" width="180" height="180" aria-label="Avatar preview"></canvas>
    <span class="cropper__ring" aria-hidden="true"></span>
  </div>
  <div class="cropper__side">
    <input type="file" name="avatar" id="avatarInput" accept="image/*">
    <label class="cropper__zoomlbl" for="cropZoom">Zoom</label>
    <input type="range" id="cropZoom" min="1" max="3" step="0.01" value="1" <%= u.avatar?'':'disabled' %> aria-label="Zoom the picture">
    <button type="button" class="btn btn--ghost cropper__reset" id="cropReset" <%= u.avatar?'':'disabled' %>>Recentre</button>
    <p class="muted cropper__hint" id="cropHint"><%= u.avatar?'Drag to move it. Use the slider to zoom.':'Choose a picture to see it here.' %></p>
  </div>
</div></div>
<div class="field"><label>Contact email <span class="muted" style="font-size:.7rem">(only Mama Bear sees this)</span></label><input type="email" name="contactEmail" value="<%= u.contactEmail||'' %>" placeholder="you@email.com"></div>
<div class="field"><label>Phone number <span class="muted" style="font-weight:400">&mdash; optional</span></label><input type="tel" name="phone" value="<%= u.phone||'' %>" placeholder="(702) 555-0123" autocomplete="tel"><p class="muted" style="margin:6px 0 0;font-size:.86rem">Leave it blank if you would rather not. If you give it, <b>only the Guild Leader can see it</b> &mdash; it never appears on your page, the roster, or anywhere else on the site. It is there so she can reach you about camp.</p></div>
<button class="btn btn--gold">Update Tabard</button></form></div>
<div class="scroll"><h3>How Ranks Rise</h3><ul class="camp-list"><li><b>Pledge</b> — signed up, awaiting the Guild Leader's welcome into the House</li><li><b>Guildmate</b> — accepted and sworn to the House</li><li><b>Veteran</b> — 3+ faires</li><li><b>Elder</b> — 6+ faires</li><li><b>Guild Leader &amp; Guild Elder</b> — by appointment of the House (Sir Caberk &amp; Mama Bear)</li></ul></div><div class="scroll"><h3>Change Password</h3><form method="post" action="/members/password"><div class="field"><label>Current password</label><input type="password" name="current" aria-label="Your current password" required></div><div class="field"><label>New password</label><input type="password" name="new" aria-label="Your new password" required minlength="6"></div><button class="btn btn--gold">Update Password</button></form></div>
</div></div></section>

<!-- The dressing controls used to live here beside a shrunken copy of the page.
     They are on the page itself now, where nothing can drift out of step. -->
<section class="section section--parch2" id="page"><div class="container" style="max-width:680px;text-align:center">
  <div class="bannerhead"><span class="eyebrow">⚜ Make It Yours ⚜</span><h2>Your Page</h2><div class="rule"></div></div>
  <p class="lead">Your page is at <a href="/guild/<%= mySlug %>" style="color:var(--wine);font-weight:600">/guild/<%= mySlug %></a>.
    The sheet fills itself in — go there and press <b>Dress this page</b> to set the colours,
    the lettering, a banner and your charms, with the page in front of you as you do it.</p>
  <a class="btn btn--gold" href="/guild/<%= mySlug %>" style="margin-top:16px">Go and dress it</a>
</div></section>

<section class="section" id="rsvp"><div class="container" style="max-width:680px;text-align:center"><div class="bannerhead"><span class="eyebrow">Are You Coming This Year?</span><h2>RSVP for the 2026 Faire</h2><div class="rule"></div></div><% if(u.rsvp){ %><p>You are marked as <b style="color:var(--forest)">coming</b> to the 2026 Faire.</p><form method="post" action="/members/rsvp" style="margin-top:14px"><button class="btn btn--ghost">I am no longer coming</button></form><% } else { %><p class="lead">Let the House know you will be there &mdash; your name gets a "Coming" mark on the public guild page.</p><form method="post" action="/members/rsvp" style="margin-top:14px"><button class="btn btn--gold">I am coming this year!</button></form><% } %></div></section><section class="section section--parch2" id="bunks"><div class="container"><div class="bannerhead"><span class="eyebrow">⚜ Camp Bunks ⚜</span><h2>Reserve a Night &amp; a Bunk</h2><div class="rule"></div></div>
<p class="lead center"><%= bunkFacts.perNightWord.charAt(0).toUpperCase()+bunkFacts.perNightWord.slice(1) %> bunks, <%= bunkFacts.nightsWord %> nights — one bed per person per night. Release yours if plans change so a guildmate can take it.</p>
<p class="lead center" style="max-width:660px;margin:0 auto 6px;font-size:.98rem">There are only <%= bunkFacts.totalWord %> beds all weekend, so they are kept for guildmates who have <b>already camped a faire</b> with the House. Beyond that it is first come, first served.</p>
<% if(u.pledge){ %><p class="lead center" style="max-width:640px;margin:0 auto 6px;font-size:1rem;color:var(--wine)"><b>You stand as a Pledge.</b> The bunks are for sworn guildmates — and then only once you have camped a faire with the House.</p><% } else if(!bunkBoard[0].canBunk){ %><p class="lead center" style="max-width:660px;margin:0 auto 6px;font-size:1rem;color:var(--wine)"><b>Your first faire is still ahead of you.</b> The bunks are kept for guildmates who have camped with the House before — come this year, and next year the camp is yours to claim.</p><% } %>
<div class="bunkgrid" style="margin-top:24px">
<% bunkBoard.forEach(function(d){ %><div class="day"><div class="day__hd"><span class="d"><%= d.night %></span><span class="h"><%= d.open ? d.open+' of 3 open' : 'full' %></span></div><div class="day__bd">
<% d.bunks.forEach(function(b){ %><div class="event"><span class="t">Bunk <%= b.bunk %><% if(b.note){ %> <small class="bunknote"><%= b.note %></small><% } %></span><span class="b"><% if(b.mine){ %><b style="color:var(--wine)">YOURS</b> <form method="post" action="/members/bunk/release" style="display:inline"><input type="hidden" name="night" value="<%= d.night %>"><input type="hidden" name="bunk" value="<%= b.bunk %>"><button class="btn btn--ghost" style="padding:5px 12px;font-size:.62rem">Release</button></form><% } else if(b.taken){ %><span class="muted">Taken by <%= b.who?b.who.name:'?' %></span><% if(leader){ %> <form method="post" action="/members/admin/bunk/release" style="display:inline"><input type="hidden" name="night" value="<%= d.night %>"><input type="hidden" name="bunk" value="<%= b.bunk %>"><button class="btn btn--ghost" style="padding:4px 9px;font-size:.56rem" title="Free this bunk — it passes to the waitlist">Free it</button></form><% } %><% } else if(!d.canBunk){ %><b>Open</b> <span class="muted" style="font-size:.72rem">— for guildmates who have camped</span><% } else { %><b>Open</b> <form method="post" action="/members/bunk" style="display:inline"><input type="hidden" name="night" value="<%= d.night %>"><input type="hidden" name="bunk" value="<%= b.bunk %>"><button class="btn btn--gold" style="padding:5px 12px;font-size:.62rem">Claim</button></form><% } %></span></div><% }) %>
<% if(d.full && !d.iHaveOne && d.canBunk){ %>
  <div class="event" style="border-top:1px solid var(--line2)">
    <span class="t" style="font-size:.72rem">Waitlist</span>
    <span class="b">
      <% if(d.myPlace){ %>
        <b style="color:var(--forest)">You're #<%= d.myPlace %></b>
        <form method="post" action="/members/waitlist/leave" style="display:inline"><input type="hidden" name="night" value="<%= d.night %>"><button class="btn btn--ghost" style="padding:5px 10px;font-size:.6rem">Leave</button></form>
      <% } else { %>
        <form method="post" action="/members/waitlist" style="display:inline"><input type="hidden" name="night" value="<%= d.night %>"><button class="btn btn--wine" style="padding:5px 12px;font-size:.62rem">Wait for one</button></form>
      <% } %>
    </span>
  </div>
<% } %>
<% if(d.waiting){ %><div class="event"><span class="t" style="font-size:.68rem;color:var(--muted)">In line</span><span class="b muted" style="font-size:.72rem"><%= d.queueNames.join(' · ') %></span></div><% } %>
</div></div><% }) %></div>
<p class="lead center" style="margin-top:22px;font-size:1rem">
  <% if(bunksLeft>0){ %><b style="color:var(--forest)"><%= bunksLeft %></b> of <%= bunkFacts.total %> bunks still open across the <%= bunkFacts.nightsWord %> nights.
  <% } else { %><b style="color:var(--wine)">All <%= bunkFacts.totalWord %> bunks are taken.</b> Join a waitlist — if someone releases theirs, it passes to whoever has waited longest.<% } %>
</p>
</div></section>

<section class="section" id="bring"><div class="container"><div class="bannerhead"><span class="eyebrow">What We Need</span><h2>Volunteer Bring-List</h2><div class="rule"></div></div>
<p class="lead center">Check off what you can bring to camp — period-accurate, of course.</p>
<div class="grid grid--2" style="margin-top:24px">
<% items.forEach(function(it){ %><div class="scroll"><h3><%= it.name %></h3><p class="muted">Need <%= it.need %> &middot; claimed <%= it.claimed %> &middot; <b style="color:<%= it.remaining>0?'var(--forest)':'var(--wine)' %>"><%= it.remaining>0?it.remaining+' left':'all filled' %></b></p>
<% if(it.claims.length){ %><p style="font-size:.92rem;margin-top:6px">Brought by: <%= it.claims.map(function(c){return c.who?c.who.name:'?'}).join(', ') %></p><% } %>
<% if(it.mine){ %><div style="display:flex;gap:8px;align-items:center;margin-top:10px;flex-wrap:wrap"><form method="post" action="/members/bring/claim" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin:0"><input type="hidden" name="itemId" value="<%= it.id %>"><label style="font-size:.7rem">You&rsquo;ll bring</label><input type="number" name="qty" aria-label="How many you will bring" value="<%= it.mine.qty %>" min="1" style="width:70px;padding:8px;border:1px solid var(--line2);border-radius:3px;background:var(--parchment)"><button class="btn btn--gold" style="padding:6px 12px;font-size:.62rem">Update</button></form><form method="post" action="/members/bring/unclaim" style="margin:0"><input type="hidden" name="itemId" value="<%= it.id %>"><button class="btn btn--ghost" style="padding:6px 12px;font-size:.62rem" aria-label="Take <%= it.name %> off your list">I can&rsquo;t</button></form></div><% } else if(it.remaining>0){ %><form method="post" action="/members/bring/claim" style="margin-top:10px"><input type="hidden" name="itemId" value="<%= it.id %>"><input type="hidden" name="qty" aria-label="How many you will bring" value="1"><button class="btn btn--wine" style="padding:6px 12px;font-size:.62rem">I'll bring this</button></form><% } %>
<% if(leader){ %><form method="post" action="/members/bring/remove" style="margin-top:8px;display:inline"><input type="hidden" name="itemId" value="<%= it.id %>"><button class="btn btn--ghost" style="padding:4px 10px;font-size:.6rem">Remove item</button></form><% } %>
</div><% }) %></div>
<% if(leader){ %><div class="scroll" style="max-width:560px;margin:24px auto 0"><h3>Add a needed item (leader)</h3><form method="post" action="/members/bring/add" style="display:flex;gap:8px;flex-wrap:wrap"><input name="name" placeholder="e.g. Extra chairs" style="flex:1;min-width:160px;padding:10px;border:1px solid var(--line2);border-radius:3px;background:var(--parchment)"><input type="number" name="need" aria-label="How many are needed" value="1" min="1" style="width:70px;padding:10px;border:1px solid var(--line2);border-radius:3px;background:var(--parchment)"><button class="btn btn--gold">Add</button></form></div><% } %>
</div></section>

<% if(leader){ %><section class="section section--dark" id="admin"><div class="container"><div class="bannerhead"><span class="eyebrow">Administration</span><h2 style="color:#f5e9c8">Roster &amp; Reservations</h2><div class="rule"></div></div>

<%
  /* Pledges waiting. This used to mean visiting each new account's page one
     at a time to see whether anyone had spoken for them. Everything needed to
     decide is here instead: who they are, who vouched, and what those people
     said in private. The private word is shown here and nowhere else. */
  var waiting=users.filter(function(m){return m.pledge;});
%>
<div class="bringers" id="pledges" style="margin-bottom:18px">
  <h3>Pledges waiting<% if(waiting.length){ %> &mdash; <%= waiting.length %><% } %></h3>
  <% if(!waiting.length){ %>
    <p class="bringers__none">Nobody is waiting at the door.</p>
  <% } else { %>
    <p class="bringers__none" style="margin-bottom:14px">Every sworn guildmate is told when someone
      pledges and asked to speak for them if they know them. What they wrote is below, and is seen
      by you alone &mdash; the pledge is only ever told <i>that</i> they were vouched for, and by whom.</p>
    <ul class="pledgelist">
      <% waiting.forEach(function(m){ %>
        <li class="pledgelist__row">
          <a class="pledgelist__face" href="/guild/<%= m.slug %>" title="See <%= m.name %>’s page">
            <% if(m.avatar){ %><img src="<%= m.avatar %>" alt=""><% } else { %><span><%= m.name.slice(0,2).toUpperCase() %></span><% } %>
          </a>
          <div class="pledgelist__body">
            <b><a href="/guild/<%= m.slug %>"><%= m.name %></a></b>
            <% if(m.contactEmail){ %><span class="pledgelist__meta"><%= m.contactEmail %></span><% } %>
            <% if(m.phone){ %><span class="pledgelist__meta"><%= m.phone %></span><% } %>
            <% if(!m.vouches.length){ %>
              <span class="pledgelist__none">Nobody has spoken for them yet.</span>
            <% } else { %>
              <ul class="pledgelist__vouches">
                <% m.vouches.forEach(function(v){ %>
                  <li><b><%= v.who %></b>
                    <small><%= new Date(v.ts).toLocaleDateString(undefined,{month:'short',day:'numeric'}) %></small>
                    <% if(v.word){ %><em>&ldquo;<%= v.word %>&rdquo;</em><% } %></li>
                <% }) %>
              </ul>
            <% } %>
          </div>
          <div class="pledgelist__act">
            <a class="btn btn--ghost" href="/guild/<%= m.slug %>" style="padding:6px 14px;font-size:.6rem">Their page</a>
            <form method="post" action="/members/admin/promote" onsubmit="return confirm('Take <%= m.name.replace(/'/g,"") %> into the House?')">
              <input type="hidden" name="id" value="<%= m.id %>">
              <button class="btn btn--gold" style="padding:6px 14px;font-size:.6rem">Take them in</button>
            </form>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>
<div class="bringers" id="prizes" style="margin-bottom:18px">
  <h3>What the House is giving</h3>
  <p class="bringers__none" style="margin-bottom:12px">Two prizes on the
    <a href="/board/roll" style="color:var(--gold-l)">Roll of Hands</a> &mdash; the best hand of the
    weekend and the runner-up. They stay sealed behind a wax seal until you tick the box, so you can
    write them down now and reveal them at the faire without anyone touching the site.</p>
  <form method="post" action="/members/admin/prizes">
    <div class="field"><label>First prize</label>
      <input name="first" value="<%= (prizes&&prizes.first)||'' %>" maxlength="140" placeholder="Kept between you and the winner"></div>
    <div class="field"><label>Runner-up</label>
      <input name="second" value="<%= (prizes&&prizes.second)||'' %>" maxlength="140" placeholder="Second best hand of the weekend"></div>
    <label style="display:flex;align-items:center;gap:9px;margin:4px 0 12px;color:#e4d3ab;font-size:.92rem">
      <input type="checkbox" name="shown" value="1" <%= (prizes&&prizes.shown)?'checked':'' %> style="width:auto">
      Break the seal &mdash; show them to everyone
    </label>
    <button class="btn btn--gold" style="padding:8px 18px;font-size:.62rem">Save the prizes</button>
  </form>
  <% if(typeof q!=="undefined" && q.prizes){ %><p class="bringers__none" style="color:var(--gold-l);margin-top:10px">Saved.</p><% } %>
<p class="bringers__none" style="margin-top:16px;color:#cdb98f"><b>A picture of each, if you have one.</b> It stays behind the seal with the words &mdash; nothing shows until you break it.</p>
<div style="display:flex;gap:14px;flex-wrap:wrap;margin-top:10px">
  <% ["first","second"].forEach(function(w){ var img=prizes&&prizes[w+"Img"]; %>
    <div style="flex:1;min-width:210px">
      <p style="font-family:var(--display);font-size:.62rem;letter-spacing:.16em;text-transform:uppercase;color:var(--gold-l);margin-bottom:6px"><%= w==="first"?"First prize":"Runner-up" %></p>
      <% if(img){ %>
        <img src="<%= img %>" alt="" style="width:100%;max-width:150px;border-radius:4px;border:1px solid var(--gold-d);display:block;margin-bottom:7px">
        <form method="post" action="/members/admin/prize-pic" style="display:inline">
          <input type="hidden" name="which" value="<%= w %>">
          <button name="remove" value="1" class="btn btn--ghost" style="padding:4px 9px;font-size:.56rem">Take it down</button>
        </form>
      <% } %>
      <form method="post" action="/members/admin/prize-pic" enctype="multipart/form-data" style="margin-top:6px">
        <input type="hidden" name="which" value="<%= w %>">
        <input type="file" name="pic" accept="image/*" required aria-label="A picture of the <%= w==="first"?"first prize":"runner-up prize" %>" style="width:100%;font-size:.72rem;color:#cdb98f">
        <button class="btn btn--ghost" style="padding:5px 10px;font-size:.58rem;margin-top:6px"><%= img?"Replace it":"Put one up" %></button>
      </form>
    </div>
  <% }) %>
</div>
</div>
<div class="bringers" id="safekeeping" style="margin-bottom:18px">
  <h3>Keep a copy safe</h3>
  <p class="bringers__none" style="margin-bottom:12px">The nightly backup lives on the same server it protects — if that server is
    ever lost, so is it. Download the roster now and again and keep it on your own machine. That is the only copy
    that survives the server going away.</p>
  <a class="btn btn--gold" href="/members/admin/backup" style="padding:8px 18px;font-size:.62rem">Download the roster</a>
</div>
<div class="bringers" id="bringing">
  <h3>Who is bringing what</h3>
  <% if(!bringers.length){ %>
    <p class="bringers__none">Nobody has claimed anything off the bring-list yet.</p>
  <% } else { %>
    <table class="bringers__table">
      <thead><tr><th>Guildmate</th><th>Bringing</th><th class="num">Items</th><th>Reach them</th></tr></thead>
      <tbody>
      <% bringers.forEach(function(b){ %>
        <tr>
          <td class="bringers__who"><%= b.name %></td>
          <td><%= b.items.map(function(x){ return x.name + (x.qty>1 ? ' ×'+x.qty : ''); }).join(', ') %></td>
          <td class="num"><%= b.total %></td>
          <td class="bringers__reach">
            <% if(b.contactEmail){ %><a href="mailto:<%= b.contactEmail %>"><%= b.contactEmail %></a><% } %>
            <% if(b.phone){ %><span><%= b.phone %></span><% } %>
            <% if(!b.contactEmail && !b.phone){ %><span class="muted">—</span><% } %>
          </td>
        </tr>
      <% }); %>
      </tbody>
    </table>
    <p class="bringers__foot"><b><%= bringers.length %></b> guildmate<%= bringers.length===1?'':'s' %> bringing <b><%= bringers.reduce(function(a,b){return a+b.total;},0) %></b> item<%= bringers.reduce(function(a,b){return a+b.total;},0)===1?'':'s' %> between them.</p>
  <% } %>
</div>
<% if(typeof q!=="undefined"){ %><% if(q.added){ %><div class="alert alert--ok" style="max-width:760px;margin:0 auto 18px">Member added.</div><% } %><% if(q.removed){ %><div class="alert alert--ok" style="max-width:760px;margin:0 auto 18px">Member removed.</div><% } %><% if(q.pwreset){ %><div class="alert alert--ok" style="max-width:760px;margin:0 auto 18px">Password reset.</div><% } %><% if(q.role){ %><div class="alert alert--ok" style="max-width:760px;margin:0 auto 18px"><%= q.role %>.</div><% } %><% if(q.merged){ %><div class="alert alert--ok" style="max-width:760px;margin:0 auto 18px"><%= q.merged %>.</div><% } %><% if(q.e){ %><div class="alert alert--bad" style="max-width:760px;margin:0 auto 18px"><% if(q.e==="pwshort"){ %>New password too short (min 4).<% } %><% if(q.e==="addreq"){ %>Name, login, and password are all required.<% } %><% if(q.e==="dup"){ %>That login is already taken.<% } %><% if(q.e==="self"){ %>You can't remove yourself.<% } %><% if(q.e==="nodel"){ %>The leader can't be removed.<% } %></div><% } %><% } %><div class="scroll" style="max-width:680px;margin:0 auto 30px;background:#241a10"><h3 style="color:#f5e9c8">Add a member</h3><form method="post" action="/members/admin/add" style="display:flex;gap:8px;flex-wrap:wrap"><input name="name" aria-label="Display name for the new member" placeholder="Display name (e.g. Sir Eric)" style="flex:1;min-width:160px;padding:9px;border:1px solid var(--gold-d);border-radius:3px;background:var(--dark2);color:#f5e9c8"><input name="email" aria-label="Login handle for the new member" placeholder="Login (e.g. eric)" style="width:120px;padding:9px;border:1px solid var(--gold-d);border-radius:3px;background:var(--dark2);color:#f5e9c8"><input name="password" type="text" aria-label="Password for the new member" placeholder="Password" style="width:120px;padding:9px;border:1px solid var(--gold-d);border-radius:3px;background:var(--dark2);color:#f5e9c8"><input name="faires" type="number" value="0" min="0" style="width:70px;padding:9px;border:1px solid var(--gold-d);border-radius:3px;background:var(--dark2);color:#f5e9c8"><button class="btn btn--gold">Add</button></form><p class="muted" style="font-size:.74rem;margin-top:8px;color:#9d8a62">Login is what they sign in with. They can change their own password later.</p></div><div class="scroll" id="announce" style="max-width:680px;margin:0 auto 30px;background:#241a10"><h3 style="color:#f5e9c8">Town Cryer &mdash; post an announcement</h3><p class="muted" style="font-size:.8rem;color:#9d8a62">Posts appear on the home page for all visitors.</p><% if(typeof q!=="undefined"&&q.ann){ %><div class="alert alert--ok" style="margin-top:8px">Announcement posted.</div><% } %><form method="post" action="/members/admin/announce" style="margin-top:10px"><textarea name="text" rows="2" placeholder="e.g. Roast of the Town Cryer returns Sunday eve!" style="width:100%;padding:10px;border:1px solid var(--gold-d);border-radius:3px;background:var(--dark2);color:#f5e9c8;font-family:var(--serif)"></textarea><button class="btn btn--gold" style="margin-top:8px">Post</button></form><% if((announcements||[]).length){ %><div style="margin-top:16px"><% announcements.slice().reverse().forEach(function(a){ %><div style="border-top:1px solid var(--gold-d);padding:10px 0;display:flex;justify-content:space-between;gap:10px;align-items:flex-start"><div style="flex:1"><%= a.text %> <span class="muted" style="font-size:.7rem">&middot; <%= new Date(a.ts).toLocaleDateString() %></span></div><form method="post" action="/members/admin/announce/remove" style="display:inline"><input type="hidden" name="id" value="<%= a.id %>"><button class="btn btn--ghost" style="padding:4px 9px;font-size:.6rem">Remove</button></form></div><% }) %></div><% } %></div><div class="scroll" id="outreach" style="max-width:680px;margin:0 auto 30px;background:#241a10"><h3 style="color:#f5e9c8">Outreach &mdash; message the guild</h3><p class="muted" style="font-size:.8rem;color:#9d8a62">Opens your email app with every member who left a contact address (BCC, so the list stays private) &mdash; or copy the list to paste into a text blast.</p><div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:10px"><a class="btn btn--gold" href="mailto:?bcc=<%= outreach.emails.join(',') %>&subject=House%20of%20Card%20and%20Coin">Email all members (<%= outreach.emails.length %>)</a><button class="btn btn--ghost" onclick="navigator.clipboard&&navigator.clipboard.writeText(_emails);this.textContent='Copied emails!'">Copy all emails</button><button class="btn btn--ghost" onclick="navigator.clipboard&&navigator.clipboard.writeText(_phones);this.textContent='Copied phones!'">Copy all phones (<%= outreach.phones.length %>)</button></div><% if(outreach.phones.length){ %><p style="font-size:.76rem;color:#cdb98f;margin-top:10px;word-break:break-all">Phones: <%= outreach.phones.join(' \u00b7 ') %></p><% } %><script>var _emails=<%- JSON.stringify(outreach.emails.join(', ')) %>;var _phones=<%- JSON.stringify(outreach.phones.join(', ')) %>;</script></div><div class="scroll" id="merge" style="max-width:680px;margin:0 auto 30px;background:#241a10"><h3 style="color:#f5e9c8">Fold two accounts into one</h3><p class="muted" style="font-size:.8rem;color:#9d8a62">For when somebody could not get in and signed up again. Keep the account that holds who they are to the guild &mdash; their name, faires, berth and title. The other gives up its login, so afterwards they sign in with the password they actually know. Everything either account ever did follows the one you keep.</p><form method="post" action="/members/admin/merge" style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-top:12px" onsubmit="return confirm('Fold these two together? The retired account disappears. This cannot be undone from here.')"><label style="font-size:.72rem;color:#cdb98f">Keep<select name="keep" aria-label="Account to keep" style="margin-left:6px;padding:8px;border:1px solid var(--gold-d);border-radius:3px;background:var(--dark2);color:#f5e9c8;font-size:.76rem"><% users.forEach(function(m){ %><option value="<%= m.id %>"><%= m.name %><%= m.leader?' (leader)':'' %></option><% }) %></select></label><label style="font-size:.72rem;color:#cdb98f">Retire, taking its login<select name="retire" aria-label="Account to retire" style="margin-left:6px;padding:8px;border:1px solid var(--gold-d);border-radius:3px;background:var(--dark2);color:#f5e9c8;font-size:.76rem"><% users.forEach(function(m){ %><option value="<%= m.id %>"<%= m.leader?' disabled':'' %>><%= m.name %><%= m.leader?' — take the keys off first':'' %></option><% }) %></select></label><button class="btn btn--wine" style="padding:7px 14px;font-size:.62rem">Fold together</button></form><p class="muted" style="font-size:.72rem;margin-top:9px;color:#9d8a62">The role is never inherited &mdash; folding cannot hand out administration by accident.</p></div><div class="roster"><% users.forEach(function(m){ %><div class="member" style="background:#241a10;border-color:var(--gold-d);text-align:left"><div style="display:flex;gap:14px;align-items:center"><a href="/guild/<%= m.slug %>" class="facelink" title="<%= m.name %>&rsquo;s page"><% if(m.avatar){ %><img src="<%= m.avatar %>" style="width:64px;height:64px;border-radius:50%;border:2px solid var(--gold);object-fit:cover;flex-shrink:0"><% } else { %><div class="avatar" style="flex-shrink:0"><%= m.name.slice(0,2).toUpperCase() %></div><% } %></a><div><h3 style="color:#f5e9c8;margin:0"><%= m.name %></h3><span class="role"><%= m.rank %><% if(m.class){ %> &middot; <%= m.class %><% } %></span><p style="font-size:.8rem;color:#cdb98f;margin:4px 0 0">Faires: <%= m.faires %></p><p style="font-size:.76rem;color:var(--gold-l);margin:2px 0"><%= m.bunks.length?m.bunks.join(" | "):"no bunk reserved" %></p><% if(m.contactEmail){ %><p style="font-size:.76rem;color:#e9dcc0;margin:2px 0">&#9993; <%= m.contactEmail %></p><% } %><% if(m.phone){ %><p style="font-size:.76rem;color:#e9dcc0;margin:2px 0">&#9742; <%= m.phone %><% if(m.dayContact){ %> <b style="color:var(--gold-l);font-size:.68rem;letter-spacing:.08em">&mdash; THE NUMBER FOR THE DAY</b><% } %></p><% } %></div></div><% if(m.pledge){ %><div class="admvouch"><% if(m.vouches.length){ %><p class="admvouch__h"><b><%= m.vouches.length %></b> spoke for them</p><% m.vouches.forEach(function(v){ %><p class="admvouch__v"><b><%= v.who %></b><% if(v.word){ %> &mdash; &ldquo;<%= v.word %>&rdquo;<% } %></p><% }) %><% } else { %><p class="admvouch__none">Nobody has spoken for them yet.</p><% } %></div><% } %><div style="margin-top:12px;display:flex;gap:6px;flex-wrap:wrap"><% if(m.pledge){ %><form method="post" action="/members/admin/promote"><input type="hidden" name="id" value="<%= m.id %>"><button class="btn btn--gold" style="padding:5px 10px;font-size:.6rem">✦ Accept into the Guild</button></form><% } else if(!m.leader){ %><form method="post" action="/members/admin/demote"><input type="hidden" name="id" value="<%= m.id %>"><button class="btn btn--ghost" style="padding:5px 9px;font-size:.6rem" title="Put this member back to Pledge">↩ Back to Pledge</button></form><% } %><form method="post" action="/members/admin/fares" style="display:flex;gap:4px;align-items:center"><input type="hidden" name="id" value="<%= m.id %>"><input type="number" name="faires" aria-label="Faires attended" value="<%= m.faires %>" min="0" style="width:54px;padding:6px;border:1px solid var(--gold-d);border-radius:3px;background:var(--dark2);color:#f5e9c8;font-size:.72rem"><button class="btn btn--ghost" style="padding:5px 9px;font-size:.6rem">Set faires</button></form><form method="post" action="/members/admin/title" style="display:flex;gap:4px;align-items:center"><input type="hidden" name="id" value="<%= m.id %>"><input type="text" name="title" value="<%= m.title||'' %>" placeholder="rank override" style="width:104px;padding:6px;border:1px solid var(--gold-d);border-radius:3px;background:var(--dark2);color:#f5e9c8;font-size:.72rem"><button class="btn btn--ghost" style="padding:5px 9px;font-size:.6rem">Rank</button></form><form method="post" action="/members/admin/resetpw" style="display:flex;gap:4px;align-items:center"><input type="hidden" name="id" value="<%= m.id %>"><input type="password" name="password" aria-label="New password for this member" placeholder="new pw" style="width:84px;padding:6px;border:1px solid var(--gold-d);border-radius:3px;background:var(--dark2);color:#f5e9c8;font-size:.72rem"><button class="btn btn--ghost" style="padding:5px 9px;font-size:.6rem">Reset pw</button></form><% if(m.phone && !m.dayContact){ %><form method="post" action="/members/admin/daycontact" onsubmit="return confirm(<%= JSON.stringify('Hand out '+m.name+'’s number to sworn guildmates on the day? It replaces whoever carries it now.') %>)"><input type="hidden" name="id" value="<%= m.id %>"><button class="btn btn--ghost" style="padding:5px 9px;font-size:.6rem" title="Make this the number the FAQ gives out on the day">☎ Number for the day</button></form><% } %><% if(m.id!==u.id && !m.pledge){ %><form method="post" action="/members/admin/role" onsubmit="return confirm(<%= m.leader ? JSON.stringify('Take the keys off '+m.name+'? They lose Administration entirely.') : JSON.stringify('Give '+m.name+' the keys? They will be able to add and remove members, reset passwords, and see every contact detail on file.') %>)"><input type="hidden" name="id" value="<%= m.id %>"><input type="hidden" name="make" value="<%= m.leader?'member':'leader' %>"><button class="btn <%= m.leader?'btn--ghost':'btn--gold' %>" style="padding:5px 9px;font-size:.6rem" title="<%= m.leader?'Withdraw administrator access':'Make this guildmate an administrator' %>"><%= m.leader?'Take the keys':'⚿ Give the keys' %></button></form><% } %><% if(m.role!=='leader' && m.id!==u.id){ %><form method="post" action="/members/admin/remove" onsubmit="return confirm('Remove <%= m.name %>? Their bunks and bring-list claims go too.')"><input type="hidden" name="id" value="<%= m.id %>"><button class="btn btn--wine" style="padding:5px 9px;font-size:.6rem">Remove</button></form><% } %></div></div><% }) %></div><div class="scroll" id="backups" style="max-width:680px;margin:26px auto 0;background:#241a10">
  <h3 style="color:#f5e9c8">The backups</h3>
  <% if(!backups.known){ %>
    <p style="color:#eec8c8"><b>No word from the backup job at all.</b> It writes a note every night, good or bad, and there is none &mdash; which means it is not running.</p>
  <% } else if(backups.good){ %>
    <p style="color:#cfe6cf"><b>&#10003; Last night&rsquo;s backup was written and read back clean.</b></p>
    <p class="muted" style="font-size:.8rem;color:#9d8a62;margin-top:6px"><%= backups.kept %> copies kept &mdash; every night for a month, then Sundays, then month firsts for two years. A second copy of each is held outside the web root. Every one is read back before any old one is deleted, so a bad night can never take the good copies with it.</p>
  <% } else if(backups.stale && backups.ok){ %>
    <p style="color:#eec8c8"><b>The last backup was <%= backups.hours %> hours ago.</b> It went well &mdash; but it should run every night, so the job itself has stopped.</p>
  <% } else { %>
    <p style="color:#eec8c8"><b>Last night&rsquo;s backup failed:</b> <%= backups.note %>.</p>
    <p class="muted" style="font-size:.8rem;color:#9d8a62;margin-top:6px">Nothing old was deleted, so the last good copy is still there. <b><%= backups.kept %></b> kept.</p>
  <% } %>
</div>
<div class="scroll" id="schedule" style="max-width:680px;margin:26px auto 0;background:#241a10">
  <h3 style="color:#f5e9c8">The Scroll of Events</h3>
  <p class="muted" style="font-size:.8rem;color:#9d8a62">What the guild is doing, and when. The Scroll shows whatever is here on the next page load &mdash; so if the fire moves an hour on the Saturday, change it here from your phone. <b>What people read is the words</b> (&ldquo;At dusk&rdquo;, &ldquo;High noon&rdquo;); the hour beside it is only used to work out what is on next.</p>
  <% schedule.days.forEach(function(day){ %>
    <p style="margin:16px 0 6px;font-family:var(--display);font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;color:var(--gold-l)"><%= day.name %></p>
    <% schedule.events.filter(function(e){return e.date===day.date;}).forEach(function(ev){ %>
      <form method="post" action="/members/admin/event" style="display:flex;gap:6px;flex-wrap:wrap;align-items:center;border-top:1px solid var(--gold-d);padding:8px 0">
        <input type="hidden" name="id" value="<%= ev.id %>">
        <input type="hidden" name="date" value="<%= ev.date %>">
        <input name="when" value="<%= ev.when %>" maxlength="40" aria-label="When, in words" style="width:104px;padding:6px;border:1px solid var(--gold-d);border-radius:3px;background:var(--dark2);color:#f5e9c8;font-size:.72rem">
        <input name="at" value="<%= ev.at || "" %>" maxlength="5" placeholder="18:30" aria-label="Rough hour" style="width:58px;padding:6px;border:1px solid var(--gold-d);border-radius:3px;background:var(--dark2);color:#cdb98f;font-size:.72rem">
        <input name="title" value="<%= ev.title %>" maxlength="80" aria-label="What it is" style="flex:1;min-width:130px;padding:6px;border:1px solid var(--gold-d);border-radius:3px;background:var(--dark2);color:#f5e9c8;font-size:.72rem">
        <input name="body" value="<%= ev.body || "" %>" maxlength="240" aria-label="A line about it" style="flex:2;min-width:170px;padding:6px;border:1px solid var(--gold-d);border-radius:3px;background:var(--dark2);color:#cdb98f;font-size:.72rem">
        <button class="btn btn--ghost" style="padding:5px 9px;font-size:.6rem">Save</button>
        <button class="btn btn--wine" name="remove" value="1" style="padding:5px 9px;font-size:.6rem" onclick="return confirm('Take this off the Scroll?')">&times;</button>
      </form>
    <% }) %>
    <form method="post" action="/members/admin/event" style="display:flex;gap:6px;flex-wrap:wrap;align-items:center;padding:8px 0">
      <input type="hidden" name="date" value="<%= day.date %>">
      <input name="when" placeholder="At dusk" maxlength="40" aria-label="When, in words" style="width:104px;padding:6px;border:1px solid var(--gold-d);border-radius:3px;background:var(--dark2);color:#f5e9c8;font-size:.72rem">
      <input name="at" placeholder="18:30" maxlength="5" aria-label="Rough hour" style="width:58px;padding:6px;border:1px solid var(--gold-d);border-radius:3px;background:var(--dark2);color:#cdb98f;font-size:.72rem">
      <input name="title" placeholder="What is happening" maxlength="80" aria-label="What it is" style="flex:1;min-width:130px;padding:6px;border:1px solid var(--gold-d);border-radius:3px;background:var(--dark2);color:#f5e9c8;font-size:.72rem">
      <input name="body" placeholder="A line about it" maxlength="240" aria-label="A line about it" style="flex:2;min-width:170px;padding:6px;border:1px solid var(--gold-d);border-radius:3px;background:var(--dark2);color:#cdb98f;font-size:.72rem">
      <button class="btn btn--gold" style="padding:5px 10px;font-size:.6rem">Add</button>
    </form>
  <% }) %>
</div>
<div class="scroll" id="invite" style="max-width:680px;margin:26px auto 0;background:#241a10">
  <h3 style="color:#f5e9c8">The invite code</h3>
  <p class="muted" style="font-size:.8rem;color:#9d8a62">What somebody needs to make an account. Change it whenever it has been passed around further than you meant. Letters and numbers only &mdash; punctuation is dropped, so it survives being read down a phone.</p>
  <p style="margin:12px 0 0"><b style="color:var(--gold-l);font-family:var(--display);font-size:1.5rem;letter-spacing:.22em"><%= invite || '(none — anyone may join)' %></b></p>
  <form method="post" action="/members/admin/invite" style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-top:12px">
    <input name="code" value="<%= invite %>" maxlength="24" aria-label="New invite code" placeholder="e.g. HOUSE2026" style="flex:1;min-width:150px;padding:9px;border:1px solid var(--gold-d);border-radius:3px;background:var(--dark2);color:#f5e9c8;font-family:var(--display);letter-spacing:.16em;text-transform:uppercase">
    <button class="btn btn--gold" style="padding:8px 16px;font-size:.62rem">Set it</button>
    <button class="btn btn--ghost" name="roll" value="1" style="padding:8px 14px;font-size:.62rem" title="Make up a new one that is hard to misread">Roll a new one</button>
  </form>
  <p class="muted" style="font-size:.74rem;margin-top:9px;color:#9d8a62">Leave it empty and press <b>Set it</b> to let anyone join without a code. Changing it does not lock out anybody who already has an account.</p>
</div></div></section><% } %>
<script defer src="/assets/js/avatar-crop.js?v=<%= typeof cssv!=='undefined'?cssv:'1' %>"></script>
<%- include('_bot') %>

<%- include('_top',{title:'Guild Hall',u:u}) %>
<% if(typeof err!=="undefined"&&err){ %><div class="container" style="max-width:600px;margin:90px auto 0"><div class="scroll" style="border-color:var(--wine);color:var(--wine)"><%= err %></div></div><% } %>
<section class="section section--parch2" style="padding-top:120px"><div class="container"><div class="bannerhead"><span class="eyebrow">Guild Hall</span><h2>Welcome, <%= u.name %></h2><div class="rule"></div></div>
<div style="display:flex;gap:18px;align-items:center;flex-wrap:wrap;justify-content:center"><% if(u.avatar){ %><img src="<%= u.avatar %>" style="width:96px;height:96px;border-radius:50%;border:3px solid var(--gold);object-fit:cover"><% } else { %><div class="member" style="padding:0;background:transparent;border:0;box-shadow:none"><div class="avatar"><%= u.name.slice(0,2).toUpperCase() %></div></div><% } %><div style="text-align:center"><div style="font-family:var(--display);font-size:1.2rem;color:var(--wine)"><%= rank %></div><div class="muted"><% if(u.class){ %>Class: <b><%= u.class %></b> &middot; <% } %>Faires with the guild: <b><%= u.faires %></b></div></div></div>
</div></section>

<section class="section" id="profile"><div class="container"><div class="bannerhead"><span class="eyebrow">Your Tabard</span><h2>Profile &amp; Rank</h2><div class="rule"></div></div><% if(typeof q!=="undefined"){ %><% if(q.pw==="ok"){ %><div class="alert alert--ok" style="max-width:760px;margin:0 auto 18px">Password updated.</div><% } %><% if(q.pw==="bad"){ %><div class="alert alert--bad" style="max-width:760px;margin:0 auto 18px">Current password was wrong.</div><% } %><% if(q.pw==="short"){ %><div class="alert alert--bad" style="max-width:760px;margin:0 auto 18px">New password must be at least 6 characters.</div><% } %><% } %>
<div class="grid grid--3"><div class="scroll"><h3>Update Your Tabard</h3><form method="post" action="/members/profile" enctype="multipart/form-data">
<div class="field"><label>Your name <span class="muted" style="font-weight:400">(how the guild sees you on the roster)</span></label><input name="name" value="<%= u.name %>" autocomplete="name" required></div>
<div class="field"><label>Choose your class</label><select name="class"><option value="">— pick a class —</option><% classes.forEach(function(c){ %><option value="<%= c %>" <%= u.class===c?'selected':'' %>><%= c %></option><% }) %></select></div>
<div class="field"><label>Ren faires attended with the guild</label><p class="muted" style="margin:0;font-size:.88rem"><b><%= u.faires %></b> — set by the Guild Leader<% if(u.pledge){ %>, once you're accepted into the guild<% } %>.</p></div>
<div class="field"><label>Avatar image</label><input type="file" name="avatar" accept="image/*"></div>
<div class="field"><label>Contact email <span class="muted" style="font-size:.7rem">(only Mama Bear sees this)</span></label><input type="email" name="contactEmail" value="<%= u.contactEmail||'' %>" placeholder="you@email.com"></div>
<div class="field"><label>Phone number <span class="muted" style="font-size:.7rem">(only Mama Bear sees this)</span></label><input type="tel" name="phone" value="<%= u.phone||'' %>" placeholder="(702) 555-0123"></div>
<button class="btn btn--gold">Update Tabard</button></form></div>
<div class="scroll"><h3>How Ranks Rise</h3><ul class="camp-list"><li><b>Pledge</b> — signed up, awaiting the Guild Leader's welcome into the House</li><li><b>Guildmate</b> — accepted and sworn to the House</li><li><b>Veteran</b> — 3+ faires</li><li><b>Elder</b> — 6+ faires</li><li><b>Guild Leader &amp; Guild Elder</b> — by appointment of the House (Sir Caberk &amp; Mama Bear)</li></ul></div><div class="scroll"><h3>Change Password</h3><form method="post" action="/members/password"><div class="field"><label>Current password</label><input type="password" name="current" required></div><div class="field"><label>New password</label><input type="password" name="new" required minlength="6"></div><button class="btn btn--gold">Update Password</button></form></div>
</div></div></section>

<section class="section" id="rsvp"><div class="container" style="max-width:680px;text-align:center"><div class="bannerhead"><span class="eyebrow">Are You Coming This Year?</span><h2>RSVP for the 2026 Faire</h2><div class="rule"></div></div><% if(u.rsvp){ %><p>You are marked as <b style="color:var(--forest)">coming</b> to the 2026 Faire.</p><form method="post" action="/members/rsvp" style="margin-top:14px"><button class="btn btn--ghost">I am no longer coming</button></form><% } else { %><p class="lead">Let the House know you will be there &mdash; your name gets a "Coming" mark on the public guild page.</p><form method="post" action="/members/rsvp" style="margin-top:14px"><button class="btn btn--gold">I am coming this year!</button></form><% } %></div></section><section class="section section--parch2" id="bunks"><div class="container"><div class="bannerhead"><span class="eyebrow">Are You Coming This Year?</span><h2>Reserve a Night &amp; a Bunk</h2><div class="rule"></div></div>
<p class="lead center">Three bunks, three nights. Claim yours for the night(s) you'll camp — release it if plans change so a guildmate can take it.</p>
<% if(u.pledge){ %><p class="lead center" style="max-width:640px;margin:0 auto 6px;font-size:1rem;color:var(--wine)"><b>You stand as a Pledge.</b> The bunks are for sworn guildmates — once the Guild Leader accepts you into the House, the camp is yours to book.</p><% } %>
<div class="grid grid--3" style="margin-top:24px">
<% bunkBoard.forEach(function(d){ %><div class="day"><div class="day__hd"><span class="d"><%= d.night %></span><span class="h">3 bunks</span></div><div class="day__bd">
<% d.bunks.forEach(function(b){ %><div class="event"><span class="t">Bunk <%= b.bunk %></span><span class="b"><% if(b.mine){ %><b style="color:var(--wine)">YOURS</b> <form method="post" action="/members/bunk/release" style="display:inline"><input type="hidden" name="night" value="<%= d.night %>"><input type="hidden" name="bunk" value="<%= b.bunk %>"><button class="btn btn--ghost" style="padding:5px 12px;font-size:.62rem">Release</button></form><% } else if(b.taken){ %><span class="muted">Taken by <%= b.who?b.who.name:'?' %></span><% } else if(u.pledge){ %><b>Open</b> <span class="muted" style="font-size:.72rem">— guildmates only</span><% } else { %><b>Open</b> <form method="post" action="/members/bunk" style="display:inline"><input type="hidden" name="night" value="<%= d.night %>"><input type="hidden" name="bunk" value="<%= b.bunk %>"><button class="btn btn--gold" style="padding:5px 12px;font-size:.62rem">Claim</button></form><% } %></span></div><% }) %>
</div></div><% }) %></div></div></section>

<section class="section" id="bring"><div class="container"><div class="bannerhead"><span class="eyebrow">What We Need</span><h2>Volunteer Bring-List</h2><div class="rule"></div></div>
<p class="lead center">Check off what you can bring to camp — period-accurate, of course.</p>
<div class="grid grid--2" style="margin-top:24px">
<% items.forEach(function(it){ %><div class="scroll"><h3><%= it.name %></h3><p class="muted">Need <%= it.need %> &middot; claimed <%= it.claimed %> &middot; <b style="color:<%= it.remaining>0?'var(--forest)':'var(--wine)' %>"><%= it.remaining>0?it.remaining+' left':'all filled' %></b></p>
<% if(it.claims.length){ %><p style="font-size:.92rem;margin-top:6px">Brought by: <%= it.claims.map(function(c){return c.who?c.who.name:'?'}).join(', ') %></p><% } %>
<% if(it.mine){ %><form method="post" action="/members/bring/claim" style="display:flex;gap:8px;align-items:center;margin-top:10px;flex-wrap:wrap"><input type="hidden" name="itemId" value="<%= it.id %>"><label style="font-size:.7rem">You'll bring</label><input type="number" name="qty" value="<%= it.mine.qty %>" min="1" style="width:70px;padding:8px;border:1px solid var(--line2);border-radius:3px;background:var(--parchment)"><button class="btn btn--gold" style="padding:6px 12px;font-size:.62rem">Update</button><form method="post" action="/members/bring/unclaim" style="display:inline"><input type="hidden" name="itemId" value="<%= it.id %>"><button class="btn btn--ghost" style="padding:6px 12px;font-size:.62rem">I can't</button></form></form><% } else if(it.remaining>0){ %><form method="post" action="/members/bring/claim" style="margin-top:10px"><input type="hidden" name="itemId" value="<%= it.id %>"><input type="hidden" name="qty" value="1"><button class="btn btn--wine" style="padding:6px 12px;font-size:.62rem">I'll bring this</button></form><% } %>
<% if(leader){ %><form method="post" action="/members/bring/remove" style="margin-top:8px;display:inline"><input type="hidden" name="itemId" value="<%= it.id %>"><button class="btn btn--ghost" style="padding:4px 10px;font-size:.6rem">Remove item</button></form><% } %>
</div><% }) %></div>
<% if(leader){ %><div class="scroll" style="max-width:560px;margin:24px auto 0"><h3>Add a needed item (leader)</h3><form method="post" action="/members/bring/add" style="display:flex;gap:8px;flex-wrap:wrap"><input name="name" placeholder="e.g. Extra chairs" style="flex:1;min-width:160px;padding:10px;border:1px solid var(--line2);border-radius:3px;background:var(--parchment)"><input type="number" name="need" value="1" min="1" style="width:70px;padding:10px;border:1px solid var(--line2);border-radius:3px;background:var(--parchment)"><button class="btn btn--gold">Add</button></form></div><% } %>
</div></section>

<% if(leader){ %><section class="section section--dark" id="admin"><div class="container"><div class="bannerhead"><span class="eyebrow">Administration</span><h2 style="color:#f5e9c8">Roster &amp; Reservations</h2><div class="rule"></div></div><% if(typeof q!=="undefined"){ %><% if(q.added){ %><div class="alert alert--ok" style="max-width:760px;margin:0 auto 18px">Member added.</div><% } %><% if(q.removed){ %><div class="alert alert--ok" style="max-width:760px;margin:0 auto 18px">Member removed.</div><% } %><% if(q.pwreset){ %><div class="alert alert--ok" style="max-width:760px;margin:0 auto 18px">Password reset.</div><% } %><% if(q.e){ %><div class="alert alert--bad" style="max-width:760px;margin:0 auto 18px"><% if(q.e==="pwshort"){ %>New password too short (min 4).<% } %><% if(q.e==="addreq"){ %>Name, login, and password are all required.<% } %><% if(q.e==="dup"){ %>That login is already taken.<% } %><% if(q.e==="self"){ %>You can't remove yourself.<% } %><% if(q.e==="nodel"){ %>The leader can't be removed.<% } %></div><% } %><% } %><div class="scroll" style="max-width:680px;margin:0 auto 30px;background:#241a10"><h3 style="color:#f5e9c8">Add a member</h3><form method="post" action="/members/admin/add" style="display:flex;gap:8px;flex-wrap:wrap"><input name="name" placeholder="Display name (e.g. Sir Eric)" style="flex:1;min-width:160px;padding:9px;border:1px solid var(--gold-d);border-radius:3px;background:var(--dark2);color:#f5e9c8"><input name="email" placeholder="Login (e.g. eric)" style="width:120px;padding:9px;border:1px solid var(--gold-d);border-radius:3px;background:var(--dark2);color:#f5e9c8"><input name="password" type="text" placeholder="Password" style="width:120px;padding:9px;border:1px solid var(--gold-d);border-radius:3px;background:var(--dark2);color:#f5e9c8"><input name="faires" type="number" value="0" min="0" style="width:70px;padding:9px;border:1px solid var(--gold-d);border-radius:3px;background:var(--dark2);color:#f5e9c8"><button class="btn btn--gold">Add</button></form><p class="muted" style="font-size:.74rem;margin-top:8px;color:#9d8a62">Login is what they sign in with. They can change their own password later.</p></div><div class="scroll" id="announce" style="max-width:680px;margin:0 auto 30px;background:#241a10"><h3 style="color:#f5e9c8">Town Cryer &mdash; post an announcement</h3><p class="muted" style="font-size:.8rem;color:#9d8a62">Posts appear on the home page for all visitors.</p><% if(typeof q!=="undefined"&&q.ann){ %><div class="alert alert--ok" style="margin-top:8px">Announcement posted.</div><% } %><form method="post" action="/members/admin/announce" style="margin-top:10px"><textarea name="text" rows="2" placeholder="e.g. Roast of the Town Cryer returns Sunday eve!" style="width:100%;padding:10px;border:1px solid var(--gold-d);border-radius:3px;background:var(--dark2);color:#f5e9c8;font-family:var(--serif)"></textarea><button class="btn btn--gold" style="margin-top:8px">Post</button></form><% if((announcements||[]).length){ %><div style="margin-top:16px"><% announcements.slice().reverse().forEach(function(a){ %><div style="border-top:1px solid var(--gold-d);padding:10px 0;display:flex;justify-content:space-between;gap:10px;align-items:flex-start"><div style="flex:1"><%= a.text %> <span class="muted" style="font-size:.7rem">&middot; <%= new Date(a.ts).toLocaleDateString() %></span></div><form method="post" action="/members/admin/announce/remove" style="display:inline"><input type="hidden" name="id" value="<%= a.id %>"><button class="btn btn--ghost" style="padding:4px 9px;font-size:.6rem">Remove</button></form></div><% }) %></div><% } %></div><div class="scroll" id="outreach" style="max-width:680px;margin:0 auto 30px;background:#241a10"><h3 style="color:#f5e9c8">Outreach &mdash; message the guild</h3><p class="muted" style="font-size:.8rem;color:#9d8a62">Opens your email app with every member who left a contact address (BCC, so the list stays private) &mdash; or copy the list to paste into a text blast.</p><div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:10px"><a class="btn btn--gold" href="mailto:?bcc=<%= outreach.emails.join(',') %>&subject=House%20of%20Card%20and%20Coin">Email all members (<%= outreach.emails.length %>)</a><button class="btn btn--ghost" onclick="navigator.clipboard&&navigator.clipboard.writeText(_emails);this.textContent='Copied emails!'">Copy all emails</button><button class="btn btn--ghost" onclick="navigator.clipboard&&navigator.clipboard.writeText(_phones);this.textContent='Copied phones!'">Copy all phones (<%= outreach.phones.length %>)</button></div><% if(outreach.phones.length){ %><p style="font-size:.76rem;color:#cdb98f;margin-top:10px;word-break:break-all">Phones: <%= outreach.phones.join(' \u00b7 ') %></p><% } %><script>var _emails=<%- JSON.stringify(outreach.emails.join(', ')) %>;var _phones=<%- JSON.stringify(outreach.phones.join(', ')) %>;</script></div><div class="roster"><% users.forEach(function(m){ %><div class="member" style="background:#241a10;border-color:var(--gold-d);text-align:left"><div style="display:flex;gap:14px;align-items:center"><% if(m.avatar){ %><img src="<%= m.avatar %>" style="width:64px;height:64px;border-radius:50%;border:2px solid var(--gold);object-fit:cover;flex-shrink:0"><% } else { %><div class="avatar" style="flex-shrink:0"><%= m.name.slice(0,2).toUpperCase() %></div><% } %><div><h3 style="color:#f5e9c8;margin:0"><%= m.name %></h3><span class="role"><%= m.rank %><% if(m.class){ %> &middot; <%= m.class %><% } %></span><p style="font-size:.8rem;color:#cdb98f;margin:4px 0 0">Faires: <%= m.faires %></p><p style="font-size:.76rem;color:var(--gold-l);margin:2px 0"><%= m.bunks.length?m.bunks.join(" | "):"no bunk reserved" %></p><% if(m.contactEmail){ %><p style="font-size:.76rem;color:#e9dcc0;margin:2px 0">&#9993; <%= m.contactEmail %></p><% } %><% if(m.phone){ %><p style="font-size:.76rem;color:#e9dcc0;margin:2px 0">&#9742; <%= m.phone %></p><% } %></div></div><div style="margin-top:12px;display:flex;gap:6px;flex-wrap:wrap"><% if(m.pledge){ %><form method="post" action="/members/admin/promote"><input type="hidden" name="id" value="<%= m.id %>"><button class="btn btn--gold" style="padding:5px 10px;font-size:.6rem">✦ Accept into the Guild</button></form><% } else if(!m.leader){ %><form method="post" action="/members/admin/demote"><input type="hidden" name="id" value="<%= m.id %>"><button class="btn btn--ghost" style="padding:5px 9px;font-size:.6rem" title="Put this member back to Pledge">↩ Back to Pledge</button></form><% } %><form method="post" action="/members/admin/fares" style="display:flex;gap:4px;align-items:center"><input type="hidden" name="id" value="<%= m.id %>"><input type="number" name="faires" value="<%= m.faires %>" min="0" style="width:54px;padding:6px;border:1px solid var(--gold-d);border-radius:3px;background:var(--dark2);color:#f5e9c8;font-size:.72rem"><button class="btn btn--ghost" style="padding:5px 9px;font-size:.6rem">Set faires</button></form><form method="post" action="/members/admin/title" style="display:flex;gap:4px;align-items:center"><input type="hidden" name="id" value="<%= m.id %>"><input type="text" name="title" value="<%= m.title||'' %>" placeholder="rank override" style="width:104px;padding:6px;border:1px solid var(--gold-d);border-radius:3px;background:var(--dark2);color:#f5e9c8;font-size:.72rem"><button class="btn btn--ghost" style="padding:5px 9px;font-size:.6rem">Rank</button></form><form method="post" action="/members/admin/resetpw" style="display:flex;gap:4px;align-items:center"><input type="hidden" name="id" value="<%= m.id %>"><input type="password" name="password" placeholder="new pw" style="width:84px;padding:6px;border:1px solid var(--gold-d);border-radius:3px;background:var(--dark2);color:#f5e9c8;font-size:.72rem"><button class="btn btn--ghost" style="padding:5px 9px;font-size:.6rem">Reset pw</button></form><% if(m.role!=='leader' && m.id!==u.id){ %><form method="post" action="/members/admin/remove" onsubmit="return confirm('Remove <%= m.name %>? Their bunks and bring-list claims go too.')"><input type="hidden" name="id" value="<%= m.id %>"><button class="btn btn--wine" style="padding:5px 9px;font-size:.6rem">Remove</button></form><% } %></div></div><% }) %></div><p class="muted center" style="margin-top:22px;color:#9d8a62">Invite code for new members: <b style="color:var(--gold-l);font-family:var(--display);letter-spacing:.1em"><%= invite %></b></p></div></section><% } %>
<%- include('_bot') %>

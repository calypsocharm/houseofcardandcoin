<%- include('_top',{title:'Whispers',bodyClass:'tavern-page'}) %>
<section class="section" style="padding-top:120px"><div class="container" style="max-width:760px">
<div class="bannerhead"><span class="eyebrow" style="color:var(--gold-l)">The Tavern</span><h2 style="color:#f8edd1">Whispers</h2><div class="rule"></div></div>
<p class="lead">Private words between seats. The walls have ears, but only the two of you can read these.</p>
<a class="btn btn--outline" href="/board" style="margin:18px 0">&larr; Back to the board</a>
<% if(!conv.length){ %><div class="compose"><p class="muted" style="margin:0">No whispers yet. Find a rogue in the gallery and send them a word.</p></div><% } %>
<% conv.forEach(function(c){ %>
<a class="whisper-row" href="/board/whisper/<%= c.other.t %>/<%= c.other.id %>"><%- include('_avatar',{name:c.name,avatar:c.avatar}) %><div style="flex:1;min-width:0"><b style="color:var(--wine)"><%= c.name %></b><p style="color:var(--ink2);margin:0;font-size:.9rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><%= c.last.body %></p></div><% if(c.unread>0){ %><span class="whisper-unread"><%= c.unread %></span><% } %></a>
<% }) %>
</div></section>
<%- include('_bot') %>
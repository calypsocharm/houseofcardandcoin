<%- include('_top',{title:t.title,bodyClass:'tavern-page'}) %>
<div class="tavern-band"><%- include('_tavern-scene') %></div><section class="section" style="padding-top:32px"><div class="container" style="max-width:820px">
<a href="/board" class="muted" style="color:#cdb98f">&larr; Back to the board</a>
<div class="note" style="margin-top:14px"><div style="display:flex;gap:14px;align-items:flex-start"><%- include('_avatar',{name:t.authorName,avatar:t.authorAvatar,slug:t.authorType==='member'?(slugs[t.authorId]||''):''}) %><div style="flex:1;min-width:0"><span class="tag"><%= t.category %></span><h2 style="color:var(--wine);margin:6px 0"><%= t.title %></h2><p class="muted" style="font-size:.78rem">by <%= t.authorName %> · <%= new Date(t.ts).toLocaleString() %></p><p style="color:var(--ink2);white-space:pre-wrap;margin-top:10px"><%= t.body %></p><%- include('_toasts',{i:i,reacts:t.reacts,action:'/board/thread/'+t.id+'/react'}) %></div></div></div>
<% if(leader){ %><form method="post" action="/board/thread/<%= t.id %>/delete" style="margin-top:12px"><button class="btn btn--wine" style="padding:6px 12px;font-size:.6rem">Strike the note</button></form><% } %>
<h3 style="color:#f8edd1;font-family:var(--display);margin:28px 0 10px">Replies</h3>
<% if(!t.replies.length){ %><p class="muted">No replies yet.</p><% } %>
<% t.replies.forEach(function(r){ %>
<div class="note" style="margin-bottom:14px"><div style="display:flex;gap:14px;align-items:flex-start"><%- include('_avatar',{name:r.authorName,avatar:r.authorAvatar,slug:r.authorType==='member'?(slugs[r.authorId]||''):''}) %><div style="flex:1;min-width:0"><p class="muted" style="font-size:.78rem;margin:0 0 6px"><%= r.authorName %> · <%= new Date(r.ts).toLocaleString() %></p><p style="color:var(--ink2);white-space:pre-wrap;margin:0"><%= r.body %></p><%- include('_toasts',{i:i,reacts:r.reacts,action:'/board/thread/'+t.id+'/reply/'+r.id+'/react'}) %><% if(leader){ %><form method="post" action="/board/reply/<%= r.id %>/delete" style="margin-top:10px"><button class="btn btn--wine" style="padding:6px 12px;font-size:.6rem">Strike</button></form><% } %></div></div></div>
<% }); %>
<% if(i){ %>
<div class="compose" style="margin-top:24px"><% if(q&&q.e){ %><div style="color:var(--wine);margin-bottom:10px"><%= q.e %></div><% } %><h3>Reply</h3><form method="post" action="/board/thread/<%= t.id %>/reply"><div class="field"><label>Your reply</label><textarea name="body" required></textarea></div><button class="btn btn--gold">Post Reply</button></form></div>
<% } else { %><div class="compose" style="margin-top:24px;text-align:center"><p class="muted" style="margin:0"><a href="/tavern">Claim a seat</a> to reply.</p></div><% } %>
</div></section>
<%- include('_bot') %>
<%- include('_top',{title:'Notices',bodyClass:'tavern-page'}) %>
<section class="section" style="padding-top:120px"><div class="container" style="max-width:760px">
<div class="bannerhead"><span class="eyebrow" style="color:var(--gold-l)">The Tavern</span><h2 style="color:#f8edd1">Your name was called</h2><div class="rule"></div></div>
<p class="lead">The latest word spoken about you across the tavern.</p>
<a class="btn btn--outline" href="/board" style="margin:18px 0">&larr; Back to the board</a>
<% if(!notices.length){ %><div class="compose"><p class="muted" style="margin:0">All quiet. No one has called your name yet.</p></div><% } %>
<% notices.forEach(function(n){ %>
<div class="note" style="margin-bottom:14px"><div style="display:flex;gap:14px;align-items:flex-start"><span class="postpic postpic--init">&#128276;</span><div style="flex:1;min-width:0"><p style="color:var(--ink2);margin:0"><%= n.text %></p><p class="muted" style="font-size:.78rem;margin:6px 0 0"><%= new Date(n.ts).toLocaleString() %></p></div></div></div>
<% }) %>
</div></section>
<%- include('_bot') %>
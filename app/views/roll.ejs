<%- include('_top',{title:'The Roll of Hands',active:'board',desc:'Every round of the House of Card and Coin — the leading hand and who held what, kept from one round to the next.',image:'/assets/img/og/index.jpg',url:'https://houseofcardandcoin.com/board/roll'}) %>
<link rel="stylesheet" href="/assets/css/tavern.css?v=<%= typeof cssv!=='undefined'?cssv:'1' %>">

<div class="tav">
  <div class="container roll">

    <div class="roll__head">
      <p class="roll__eyebrow">⚜ The Roll of Hands ⚜</p>
      <h1>Who Held What</h1>
      <p class="roll__lead">
        <% if(gates.ended){ %>The faire has been and gone.
        <% } else if(gates.open){ %>The gates are open — bring your hand to the table.
        <% } else { %>A round runs until the House calls it. Then the deck is shuffled and it begins again,
          which is how the game lasts all the way to the gates.<% } %>
      </p>
      <p class="roll__back"><a href="/board">← Back to the Tavern</a></p>
    </div>

    <% if(q.closed){ %>
      <p class="roll__said">Round <%= q.closed %> is closed and written into the roll. Every deck is shuffled — the next card is there for the taking.</p>
    <% } %>
    <% if(q.e==='empty'){ %>
      <p class="roll__warn">Nobody is holding a card, so there was no round to close.</p>
    <% } %>

    <!-- ── the round being played now ──────────────────────────────────── -->
    <section class="roll__now">
      <h2>The round in play</h2>
      <%
        /* The two ways this round can end, stated plainly. It closes itself
           now, so the table needs to say when. */
        var _ends=new Date(roundEnds);
        var _left=Math.max(0,Math.ceil((roundEnds-Date.now())/86400000));
      %>
      <p class="roll__ends">
        Round <b><%= roundNo %></b> closes <b><%= _ends.toLocaleDateString('en-US',{month:'long',day:'numeric'}) %></b><%
          if(_left<=3){ %> &mdash; <%= _left===0?'today':(_left===1?'tomorrow':'in '+_left+' days') %><% } %>,
        or as soon as every hand below is holding five. Whichever comes first.
      </p>

      <%
        /* The standing high hand — every round already played and this one
           together. A round is a heat; this is the contest that runs to the
           gates, and it is what the roster's ribbon reads from. */
      %>
      <% if(high.rank){ %>
        <p class="roll__high">
          <span class="roll__high__k">✦ High hand of the run</span>
          <b><%= high.names.join(' & ') %></b>
          <span class="roll__high__r"><%= high.rank %></span>
          <small>made in <%= high.when %><%= high.shared?', and matched since':'' %> · stands until the gates open</small>
        </p>
      <% } %>
      <% if(table.length){ %>
        <div class="roll__grid">
          <% table.forEach(function(h,n){ %>
            <div class="roll__tile<%= n<atTop?' is-top':'' %>">
              <div class="roll__who">
                <%- include('_avatar',{name:h.name,avatar:h.avatar,slug:h.kind==='member'&&h.id?(slugs[h.id]||''):''}) %>
                <span class="roll__name"><%= h.name %><% if(n<atTop){ %><small><%= atTop>1?'level in front':'leading' %></small><% } %></span>
              </div>
              <span class="roll__cards">
                <% h.cards.forEach(function(c){ %>
                  <span class="pcard pcard--tiny<%= c.red?' is-red':'' %>"><b class="pcard__r"><%= c.r==='T'?'10':c.r %></b><span class="pcard__s"><%= c.glyph %></span></span>
                <% }) %>
              </span>
              <p class="roll__rank"><%= h.rank?h.rank.name:'—' %><% if(h.rank&&h.rank.short){ %> <small>on <%= h.rank.cards %></small><% } %></p>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <p class="roll__none">No cards are out. Come by the Tavern of an evening and the House will deal you one.</p>
      <% } %>

      <% if(leader){ %>
        <form class="roll__close" method="post" action="/members/admin/round/close"
              onsubmit="return confirm('Close this round? Every hand goes into the roll and all the decks are shuffled.')">
          <button class="btn btn--wine" type="submit">Call the round</button>
          <span>Writes the table into the roll below and starts a fresh one.</span>
        </form>
      <% } %>
    </section>

    <!-- ── what is in it for the winners ───────────────────────────────── -->
    <%
      /* Sealed unless the Guild Leader has said to show them. Not knowing is
         half the point, so the sealed state is the interesting one and gets
         the care: a wax seal, not a greyed-out box saying "hidden". */
    %>
    <section class="roll__prizes">
      <h2>What the House is giving</h2>
      <div class="prizes">
        <div class="prize prize--first">
          <span class="prize__rank">First hand of the faire</span>
          <% if(prizes.shown && (prizes.first || prizes.firstImg)){ %>
            <% if(prizes.firstImg){ %>
              <img class="prize__pic" src="<%= prizes.firstImg %>" alt="<%= prizes.first || "The prize" %>" width="760" height="760" loading="lazy">
            <% } %>
            <% if(prizes.first){ %><span class="prize__what">🎁 <%= prizes.first %></span><% } %>
          <% } else { %>
            <span class="prize__sealed" aria-label="Sealed until the faire">🎁</span>
            <span class="prize__hint">Sealed until the faire</span>
          <% } %>
        </div>
        <div class="prize prize--second">
          <span class="prize__rank">Runner-up</span>
          <% if(prizes.shown && (prizes.second || prizes.secondImg)){ %>
            <% if(prizes.secondImg){ %>
              <img class="prize__pic" src="<%= prizes.secondImg %>" alt="<%= prizes.second || "The prize" %>" width="760" height="760" loading="lazy">
            <% } %>
            <% if(prizes.second){ %><span class="prize__what">🎁 <%= prizes.second %></span><% } %>
          <% } else { %>
            <span class="prize__sealed" aria-label="Sealed until the faire">🎁</span>
            <span class="prize__hint">Sealed until the faire</span>
          <% } %>
        </div>
      </div>
      <p class="prize__note">
        <% if(prizes.shown && (prizes.first||prizes.second)){ %>
          Bring your hand to our table at the faire and show it.
        <% } else { %>
          Neither is being told before the gates open. Bring your hand to our table
          and show it &mdash; the best of the weekend takes the first, the next takes the runner-up.
        <% } %>
      </p>
    </section>

    <!-- ── the standing tally ──────────────────────────────────────────── -->
    <% if(champions.length){ %>
      <section class="roll__tally">
        <h2>Rounds taken</h2>
        <ol class="tally">
          <% champions.forEach(function(c,n){ %>
            <li class="tally__row<%= n===0&&c.taken?' is-first':'' %>">
              <span class="tally__pos"><%= n+1 %></span>
              <%- include('_avatar',{name:c.name,avatar:c.avatar,slug:c.slug}) %>
              <span class="tally__name">
                <% if(c.slug){ %><a href="/guild/<%= c.slug %>"><%= c.name %></a><% } else { %><%= c.name %><% } %>
                <% if(c.best){ %><small>best: <%= c.best.name %></small><% } %>
              </span>
              <span class="tally__score">
                <b><%= c.taken %></b>
                <small>of <%= c.played %> played</small>
              </span>
            </li>
          <% }) %>
        </ol>
        <p class="roll__note">A round is shared when two hands finish level.</p>
      </section>
    <% } %>

    <!-- ── rounds already played ───────────────────────────────────────── -->
    <% if(rounds.length){ %>
      <section class="roll__past">
        <h2>Rounds already played</h2>
        <% rounds.forEach(function(r){ %>
          <div class="roll__round">
            <p class="roll__rhead">
              <b>Round <%= r.n %></b>
              <span><%= new Date(r.ended).toLocaleDateString(undefined,{month:'long',day:'numeric'}) %></span>
            </p>
            <% r.hands.forEach(function(h,n){ %>
              <div class="roll__line<%= h.won?' is-win':'' %>">
                <span class="roll__lname">
                  <% if(h.won){ %><span class="roll__crown" title="Took the round">✦</span><% } %>
                  <% if(h.slug){ %><a href="/guild/<%= h.slug %>"><%= h.name %></a><% } else { %><%= h.name %><% } %>
                </span>
                <span class="roll__lcards">
                  <% h.cards.forEach(function(c){ %>
                    <span class="pcard pcard--tiny<%= c.red?' is-red':'' %>"><b class="pcard__r"><%= c.r==='T'?'10':c.r %></b><span class="pcard__s"><%= c.glyph %></span></span>
                  <% }) %>
                </span>
                <span class="roll__lrank"><%= h.rank?h.rank.name:'—' %></span>
              </div>
            <% }) %>
          </div>
        <% }) %>
      </section>
    <% } %>

  </div>
</div>

<%- include('_bot') %>

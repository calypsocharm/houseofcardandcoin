<% const E=['\uD83C\uDF7A','\uD83E\uDE99','\uD83D\uDD25','\u2694\uFE0F']; %>
<div class="toasts"><% if(i){ %><form method="post" action="<%= action %>" class="toasts__form"><% E.forEach(function(e){ var list=(reacts&&reacts[e])||[]; var mine=list.find(function(v){return v.t===i.t&&v.id===i.id;}); %><button class="toast<%= mine?' toast--mine':'' %>" name="emoji" value="<%= e %>" type="submit"><span><%= e %></span><b><%= list.length %></b></button><% }) %></form><% } else { E.forEach(function(e){ var list=(reacts&&reacts[e])||[]; %><span class="toast toast--off"><span><%= e %></span><b><%= list.length %></b></span><% }) %><a href="/tavern" class="toast__hint">Claim a seat to toast</a><% } %></div>